.bottom-nav {
  position: fixed;
  right: 32rpx;
  bottom: 34rpx;
  left: 32rpx;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 106rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(255,255,255,.96);
  border-radius: 58rpx;
  background: rgba(255,255,255,.9);
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,.12);
  backdrop-filter: blur(18rpx);
}
.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  color: #696a70;
  font-size: 20rpx;
  line-height: 1;
}
.nav-icon {
  display: block;
  margin-bottom: 8rpx;
  font-size: 34rpx;
  line-height: 1;
}
.nav-item.selected {
  color: #111013;
  font-weight: 650;
}
.nav-item.selected .nav-icon {
  color: #111013;
}
.nav-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  margin-top: -44rpx;
  border-radius: 50%;
  background: #101013;
  color: #fff;
  font-size: 56rpx;
  line-height: 1;
  box-shadow: 0 12rpx 24rpx rgba(0,0,0,.22);
}
.more-mask{position:fixed;inset:0;z-index:35;background:transparent}.more-menu{position:absolute;right:32rpx;bottom:154rpx;left:32rpx;padding:12rpx;border:1rpx solid rgba(255,255,255,.92);border-radius:28rpx;background:rgba(255,255,255,.94);box-shadow:0 -12rpx 44rpx rgba(20,25,35,.16)}.more-item{display:flex;align-items:center;gap:18rpx;padding:22rpx 18rpx;border-radius:18rpx;font-size:26rpx}.more-item text:first-child{width:42rpx;color:#111118;font-size:30rpx;text-align:center}.more-item text:nth-child(2){flex:1;font-weight:700}.more-item text:last-child{color:#8b8f99;font-size:34rpx}
.nav-logo{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:rgba(255,255,255,.78);color:#111118;font-size:42rpx;box-shadow:0 8rpx 20rpx rgba(0,0,0,.1)}.nav-add-slot{width:92rpx;height:92rpx;margin-top:-44rpx}
