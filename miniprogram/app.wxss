page {
  background: #f6f8fa;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button::after {
  border: 0;
}

/* Shared interaction guards for native mobile sheets. Keep the primary action
   reachable on short devices and allow the sheet itself to scroll. */
.create-sheet,
.sheet,
.add-sheet,
.journey-settings {
  max-height: calc(100vh - 32rpx) !important;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom)) !important;
}

.create-sheet {
  height: calc(100vh - 32rpx) !important;
}

.sheet-mask,
.mask {
  z-index: 100 !important;
}

.create-sheet {
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom)) !important;
}

.add-sheet {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom)) !important;
}

.cover-search-row {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}
.cover-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e2e4e8;
  border-radius: 16rpx;
  background: #fafafa;
  box-sizing: border-box;
  font-size: 24rpx;
}
.cover-search-button {
  width: 132rpx;
  height: 72rpx;
  margin: 0;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: #111118;
  color: #fff;
  font-size: 23rpx;
}
.cover-results {
  display: flex;
  width: 100%;
  margin-top: 14rpx;
  white-space: nowrap;
}
.cover-result {
  position: relative;
  display: inline-block;
  width: 190rpx;
  height: 128rpx;
  margin-right: 12rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.cover-result.selected { border-color: #12a979; }
.cover-result image { width: 100%; height: 100%; }
.cover-result text {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
  padding: 8rpx;
  background: rgba(0,0,0,.5);
  color: #fff;
  font-size: 17rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cover-preview {
  width: 100%;
  height: 150rpx;
  margin-top: 14rpx;
  border-radius: 16rpx;
}
