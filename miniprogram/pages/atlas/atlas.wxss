.page{position:relative;height:100vh;overflow:hidden;background:#dfe4e7;color:#11151f}.map{position:absolute;inset:0;width:100%;height:100%;filter:saturate(.55) contrast(.92)}.glass-title{position:absolute;top:44rpx;left:42rpx;right:42rpx;height:82rpx;line-height:82rpx;text-align:center;border:1rpx solid rgba(255,255,255,.8);border-radius:45rpx;background:rgba(255,255,255,.86);font-size:34rpx;font-weight:900;box-shadow:0 12rpx 30rpx rgba(20,25,35,.12)}.stats{position:absolute;left:42rpx;right:42rpx;bottom:270rpx;display:flex;justify-content:space-around;padding:25rpx;border-radius:30rpx;background:rgba(255,255,255,.86);border:1rpx solid rgba(255,255,255,.8);box-shadow:0 12rpx 30rpx rgba(20,25,35,.12)}.stats view{text-align:center}.stats text,.stats small{display:block}.stats text{font-size:42rpx;font-weight:900}.stats small{margin-top:6rpx;color:#777e88;font-size:20rpx}.quick{position:absolute;left:42rpx;right:42rpx;bottom:430rpx;padding:10rpx 22rpx;border-radius:30rpx;background:rgba(255,255,255,.86);border:1rpx solid rgba(255,255,255,.8)}.quick view{display:flex;align-items:center;gap:22rpx;padding:24rpx 12rpx;border-bottom:1rpx solid rgba(20,25,35,.08);font-size:28rpx;font-weight:800}.quick view:last-child{border-bottom:0}.quick view text:nth-child(2){flex:1}.quick-icon{font-size:40rpx}.search{position:absolute;left:42rpx;right:42rpx;top:150rpx;display:flex;gap:12rpx;padding:16rpx;border-radius:28rpx;background:#fff}.search input{flex:1;height:70rpx;padding:0 20rpx;border:1rpx solid #e1e4e8;border-radius:18rpx}.search button{margin:0;height:70rpx;line-height:70rpx;background:#111218;color:#fff;border-radius:18rpx;font-size:23rpx}.error{position:absolute;top:140rpx;left:42rpx;right:42rpx;color:#d04455;background:#fff;padding:15rpx;border-radius:20rpx}.bottom{position:absolute;left:32rpx;right:32rpx;bottom:24rpx;height:112rpx;display:flex;align-items:center;justify-content:space-around;border-radius:58rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 40rpx rgba(20,25,35,.15)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav text{font-size:19rpx}.nav.active{color:#11151f}.search-fab{width:82rpx;height:82rpx;justify-content:center;border-radius:50%;background:#111218;color:#fff;font-size:42rpx}
