.page{position:relative;height:100vh;overflow:hidden;background:#dfe4e7;color:#11151f}.map{position:absolute;inset:0;width:100%;height:100%;filter:saturate(.55) contrast(.92)}.glass-title{position:absolute;top:44rpx;left:42rpx;right:42rpx;height:82rpx;line-height:82rpx;text-align:center;border:1rpx solid rgba(255,255,255,.8);border-radius:45rpx;background:rgba(255,255,255,.86);font-size:34rpx;font-weight:900;box-shadow:0 12rpx 30rpx rgba(20,25,35,.12)}.stats{position:absolute;left:42rpx;right:42rpx;bottom:270rpx;display:flex;justify-content:space-around;padding:25rpx;border-radius:30rpx;background:rgba(255,255,255,.86);border:1rpx solid rgba(255,255,255,.8);box-shadow:0 12rpx 30rpx rgba(20,25,35,.12)}.stats view{text-align:center}.stats text,.stats small{display:block}.stats text{font-size:42rpx;font-weight:900}.stats small{margin-top:6rpx;color:#777e88;font-size:20rpx}.quick{position:absolute;left:42rpx;right:42rpx;bottom:430rpx;padding:10rpx 22rpx;border-radius:30rpx;background:rgba(255,255,255,.86);border:1rpx solid rgba(255,255,255,.8)}.quick view{display:flex;align-items:center;gap:22rpx;padding:24rpx 12rpx;border-bottom:1rpx solid rgba(20,25,35,.08);font-size:28rpx;font-weight:800}.quick view:last-child{border-bottom:0}.quick view text:nth-child(2){flex:1}.quick-icon{font-size:40rpx}.search{position:absolute;left:42rpx;right:42rpx;top:150rpx;display:flex;gap:12rpx;padding:16rpx;border-radius:28rpx;background:#fff}.search input{flex:1;height:70rpx;padding:0 20rpx;border:1rpx solid #e1e4e8;border-radius:18rpx}.search button{margin:0;height:70rpx;line-height:70rpx;background:#111218;color:#fff;border-radius:18rpx;font-size:23rpx}.error{position:absolute;top:140rpx;left:42rpx;right:42rpx;color:#d04455;background:#fff;padding:15rpx;border-radius:20rpx}.bottom{position:absolute;left:32rpx;right:32rpx;bottom:24rpx;height:112rpx;display:flex;align-items:center;justify-content:space-around;border-radius:58rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 40rpx rgba(20,25,35,.15)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav text{font-size:19rpx}.nav.active{color:#11151f}.search-fab{width:82rpx;height:82rpx;justify-content:center;border-radius:50%;background:#111218;color:#fff;font-size:42rpx}.mask{position:absolute;inset:0;z-index:20;display:flex;align-items:flex-end;background:rgba(10,14,22,.38)}.bucket-sheet{width:100%;max-height:72vh;padding:32rpx 34rpx 42rpx;box-sizing:border-box;border-radius:36rpx 36rpx 0 0;background:#fff}.sheet-head{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:900}.close{font-size:46rpx;font-weight:400;color:#777}.bucket-list{max-height:48vh;margin-top:20rpx}.bucket-item{display:flex;align-items:center;gap:16rpx;padding:24rpx 8rpx;border-bottom:1rpx solid #eceef1}.bucket-copy{flex:1;min-width:0}.bucket-name{display:block;font-size:28rpx;font-weight:800}.bucket-meta{display:block;margin-top:8rpx;color:#858b95;font-size:21rpx}.bucket-remove{padding:16rpx;color:#c53d55;font-size:38rpx}.bucket-empty{padding:70rpx 20rpx;color:#888f99;text-align:center;font-size:24rpx}.bucket-add{margin-top:24rpx;background:#111218;color:#fff;border-radius:22rpx;font-size:27rpx}
.search-results{max-height:360rpx;margin-top:12rpx;border-radius:18rpx;background:rgba(255,255,255,.96);overflow:hidden}.search-result{padding:18rpx 20rpx;border-bottom:1rpx solid #e8eaee}.search-name{display:block;font-size:26rpx;font-weight:800}.search-address{display:block;margin-top:6rpx;color:#7f8690;font-size:21rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.planned-toggle{position:absolute;top:132rpx;right:42rpx;z-index:4;padding:14rpx 20rpx;border-radius:28rpx;background:rgba(255,255,255,.88);color:#30343a;font-size:22rpx;box-shadow:0 8rpx 22rpx rgba(20,30,40,.1)}.country-sheet{width:100%;padding:34rpx 32rpx 48rpx;background:#fff;border-radius:34rpx 34rpx 0 0;box-sizing:border-box}.country-summary{display:block;margin-top:24rpx;color:#737b86;font-size:25rpx}.country-action{margin-top:28rpx;padding:24rpx;border-radius:20rpx;background:#151722;color:#fff;text-align:center;font-size:27rpx}
