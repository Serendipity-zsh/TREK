<view class="page"><map class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" enable-zoom enable-scroll></map><view class="glass-title">心愿单</view><view class="stats"><view><text>{{stats.totalCountries || stats.visited_countries || 0}}</text><small>已访问国家</small></view><view><text>{{stats.totalPlaces || stats.places || 0}}</text><small>个地点</small></view><view><text>{{bucket.length}}</text><small>个愿望</small></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{searchOpen}}" class="search"><input focus placeholder="搜索国家或地点" value="{{query}}" bindinput="input" bindconfirm="search" /><button bindtap="search">搜索</button></view><view class="quick"><view bindtap="openCollections"><text class="quick-icon">⌑</text><text>收藏</text><text>›</text></view><view bindtap="openTools"><text class="quick-icon">◎</text><text>旅程工具</text><text>›</text></view></view><view class="bottom"><view class="nav" bindtap="goHome">▦<text>行程</text></view><view class="nav" bindtap="openCollections">▣<text>日历</text></view><view class="nav search-fab" bindtap="toggleSearch">⌕</view><view class="nav active">◎<text>Atlas</text></view><view class="nav" bindtap="openTools">•••<text>更多</text></view></view></view>
