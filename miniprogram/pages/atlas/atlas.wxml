<view class="page"><map class="map" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{scale}}" markers="{{markers}}" polygons="{{polygons}}" bindtap="tapMap" enable-zoom enable-scroll></map><view class="glass-title" bindtap="openBucket">心愿单 · {{bucket.length}}</view><view class="stats"><view><text>{{stats.totalCountries || stats.visited_countries || 0}}</text><small>已访问国家</small></view><view><text>{{stats.totalPlaces || stats.places || 0}}</text><small>个地点</small></view><view><text>{{bucket.length}}</text><small>个愿望</small></view></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{searchOpen}}" class="search"><input focus placeholder="搜索景点、酒店或地址" value="{{query}}" bindinput="input" bindconfirm="search" /><button bindtap="search">搜索</button><scroll-view wx:if="{{searchResults.length}}" scroll-y class="search-results"><view wx:for="{{searchResults}}" wx:key="id" class="search-result" data-index="{{index}}" bindtap="selectSearchResult"><text class="search-name">{{item.name}}</text><text class="search-address">{{item.address || item.district || '暂无地址'}}</text></view></scroll-view></view><view class="quick"><view bindtap="openBucket"><text class="quick-icon">⌑</text><text>愿望单</text><text>›</text></view><view bindtap="openCollections"><text class="quick-icon">◎</text><text>收藏与清单</text><text>›</text></view><view bindtap="openTools"><text class="quick-icon">◌</text><text>旅程工具</text><text>›</text></view></view><view class="bottom"><view class="nav" bindtap="goHome">▦<text>行程</text></view><view class="nav" bindtap="openCalendar">▣<text>日历</text></view><view class="nav search-fab" bindtap="toggleSearch">⌕</view><view class="nav active">◎<text>探索</text></view><view class="nav" bindtap="openTools">•••<text>更多</text></view></view><view wx:if="{{bucketOpen}}" class="mask" catchtap="closeBucket"><view class="bucket-sheet" catchtap="noop"><view class="sheet-head"><text>愿望单</text><text class="close" bindtap="closeBucket">×</text></view><view wx:if="{{!bucket.length}}" class="bucket-empty">还没有愿望，搜索一个地点加入吧。</view><scroll-view wx:else scroll-y class="bucket-list"><view wx:for="{{bucket}}" wx:key="id" class="bucket-item"><view class="bucket-copy"><text class="bucket-name">{{item.name}}</text><text class="bucket-meta">{{item.country_code || '待确认地点'}}{{item.target_date ? ' · ' + item.target_date : ''}}</text></view><text class="bucket-remove" data-index="{{index}}" bindtap="removeBucket">×</text></view></scroll-view><button class="bucket-add" bindtap="createBucket">＋ 加入愿望</button></view></view></view>
