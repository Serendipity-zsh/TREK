.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;gap:16rpx;padding:32rpx 32rpx 20rpx;background:#fff}.back{font-size:58rpx;line-height:1}.title{font-size:38rpx;font-weight:800;flex:1}.create{margin:0;padding:0 24rpx;height:72rpx;line-height:72rpx;border-radius:40rpx;background:#151722;color:#fff;font-size:24rpx}.feed{height:calc(100vh - 190rpx);padding:14rpx 32rpx 180rpx;box-sizing:border-box}.journey-card{overflow:hidden;margin:18rpx 0;border:1rpx solid #e2e4e8;border-radius:34rpx;background:#fff;box-shadow:0 16rpx 36rpx rgba(20,25,35,.08)}.cover{height:230rpx;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#101421,#263e63);color:#fff;font-size:70rpx;font-weight:900}.journey-body{padding:26rpx}.journey-title{display:block;font-size:32rpx;font-weight:800}.stats{display:block;margin-top:14rpx;color:#737985;font-size:23rpx}.empty{padding:180rpx 30rpx;text-align:center;color:#8a909b;font-size:26rpx}.empty-mark{display:block;margin-bottom:18rpx;font-size:80rpx;color:#16ad78}.error{color:#d04455}.bottom{position:fixed;left:32rpx;right:32rpx;bottom:24rpx;display:flex;align-items:center;justify-content:space-around;height:112rpx;border:1rpx solid #e3e5e9;border-radius:58rpx;background:rgba(255,255,255,.94);box-shadow:0 15rpx 40rpx rgba(20,25,35,.12)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav text{font-size:20rpx}.nav.active{color:#11151f}.nav-add{display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;margin-top:-44rpx;border-radius:50%;background:#111218;color:#fff;font-size:54rpx;box-shadow:0 10rpx 22rpx rgba(0,0,0,.2)}.mask{position:fixed;inset:0;background:rgba(10,14,22,.42);display:flex;align-items:flex-end}.sheet{width:100%;padding:44rpx 36rpx 60rpx;border-radius:38rpx 38rpx 0 0;background:#fff;box-sizing:border-box}.sheet-title{display:block;margin-bottom:28rpx;font-size:36rpx;font-weight:800}.sheet input{height:92rpx;padding:0 24rpx;border:1rpx solid #dfe2e8;border-radius:22rpx;box-sizing:border-box}.primary{margin-top:26rpx;background:#151722;color:#fff;border-radius:22rpx;font-size:28rpx}
