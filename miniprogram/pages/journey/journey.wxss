.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;gap:16rpx;padding:32rpx 32rpx 20rpx;background:#fff}.back{font-size:58rpx;line-height:1}.title{font-size:38rpx;font-weight:800;flex:1}.create{margin:0;padding:0 24rpx;height:72rpx;line-height:72rpx;border-radius:40rpx;background:#151722;color:#fff;font-size:24rpx}.feed{height:calc(100vh - 190rpx);padding:14rpx 32rpx 180rpx;box-sizing:border-box}.hero-card{position:relative;height:390rpx;overflow:hidden;margin:18rpx 0 30rpx;border-radius:34rpx;background:#132039;box-shadow:0 18rpx 42rpx rgba(20,25,35,.18)}.hero-cover{position:absolute;inset:0;width:100%;height:100%}.hero-cover.fallback{display:flex;align-items:center;justify-content:center;color:#fff;font-size:70rpx;font-weight:900}.hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08) 30%,rgba(0,0,0,.72) 100%)}.hero-badge{position:absolute;top:22rpx;left:22rpx;padding:10rpx 18rpx;border-radius:28rpx;background:rgba(255,255,255,.92);color:#111218;font-size:20rpx;font-weight:800}.hero-copy{position:absolute;right:24rpx;bottom:24rpx;left:24rpx;color:#fff}.hero-title{display:block;font-size:42rpx;font-weight:850}.hero-copy .stats{color:rgba(255,255,255,.82)}.other-label{display:flex;align-items:center;gap:16rpx;margin:10rpx 4rpx 14rpx;color:#8a909b;font-size:20rpx;font-weight:700}.other-label text:first-child,.other-label text:last-child{height:1rpx;flex:1;background:#dfe2e8}.journey-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.journey-card{overflow:hidden;border:1rpx solid #e2e4e8;border-radius:28rpx;background:#fff;box-shadow:0 12rpx 30rpx rgba(20,25,35,.08)}.journey-card.compact{margin:0}.cover{display:flex;align-items:center;justify-content:center;width:100%;height:150rpx;color:#fff;font-size:42rpx;font-weight:900}.journey-body{padding:20rpx}.journey-title{display:block;overflow:hidden;font-size:28rpx;font-weight:800;text-overflow:ellipsis;white-space:nowrap}.stats{display:block;margin-top:10rpx;color:#737985;font-size:21rpx}.empty{padding:180rpx 30rpx;text-align:center;color:#8a909b;font-size:26rpx}.empty-mark{display:block;margin-bottom:18rpx;font-size:80rpx;color:#16ad78}.error{color:#d04455}.mask{position:fixed;inset:0;background:rgba(10,14,22,.42);display:flex;align-items:flex-end}.sheet{width:100%;padding:44rpx 36rpx 60rpx;border-radius:38rpx 38rpx 0 0;background:#fff;box-sizing:border-box}.sheet-title{display:block;margin-bottom:28rpx;font-size:36rpx;font-weight:800}.sheet input{height:92rpx;padding:0 24rpx;border:1rpx solid #dfe2e8;border-radius:22rpx;box-sizing:border-box}.primary{margin-top:26rpx;background:#151722;color:#fff;border-radius:22rpx;font-size:28rpx}
