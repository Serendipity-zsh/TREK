<view class="page">
  <view class="top"><text class="back" bindtap="openTools">‹</text><text class="title">旅记</text><button class="create" bindtap="openCreate">＋ 新建旅记</button></view>
  <scroll-view scroll-y class="feed">
    <view wx:if="{{loading}}" class="empty">正在加载…</view>
    <view wx:elif="{{error}}" class="empty error">{{error}}</view>
    <view wx:elif="{{!journeys.length}}" class="empty"><text class="empty-mark">✦</text><text>还没有旅记，记录一次旅程吧。</text></view>
    <block wx:else>
      <view wx:if="{{heroJourney}}" class="hero-card" data-id="{{heroJourney.id}}" bindtap="openJourney">
        <image wx:if="{{heroJourney.cover_image}}" class="hero-cover" src="{{heroJourney.cover_image}}" mode="aspectFill" />
        <view wx:else class="hero-cover fallback" style="background:{{heroJourney.coverColor}}"><text>trek</text></view>
        <view class="hero-shade"></view>
        <text class="hero-badge">最新旅记</text>
        <view class="hero-copy"><text class="hero-title">{{heroJourney.title}}</text><text class="stats">{{heroJourney.entry_count || 0}} 篇 · {{heroJourney.photo_count || 0}} 张 · {{heroJourney.place_count || 0}} 个地点</text></view>
      </view>
      <view wx:if="{{otherJourneys.length}}" class="other-label"><text></text><text>其他旅记</text><text></text></view>
      <view wx:if="{{otherJourneys.length}}" class="journey-grid">
        <view wx:for="{{otherJourneys}}" wx:key="id" class="journey-card compact" data-id="{{item.id}}" bindtap="openJourney">
          <image wx:if="{{item.cover_image}}" class="cover" src="{{item.cover_image}}" mode="aspectFill" />
          <view wx:else class="cover" style="background:{{item.coverColor}}"><text>trek</text></view>
          <view class="journey-body"><text class="journey-title">{{item.title}}</text><text class="stats">{{item.entry_count || 0}} · {{item.photo_count || 0}} · {{item.place_count || 0}}</text></view>
        </view>
      </view>
    </block>
  </scroll-view>
  <bottom-nav active="more" bind:create="openCreate" />
  <view wx:if="{{showCreate}}" class="mask" catchtap="closeCreate"><view class="sheet create-sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">新建旅记</text><text class="sheet-close" bindtap="closeCreate">×</text></view><input placeholder="例如：日本秋日" value="{{title}}" bindinput="onTitleInput" /><text class="trip-label">关联已有行程（可选）</text><scroll-view wx:if="{{availableTrips.length}}" scroll-y class="trip-options"><view wx:for="{{availableTrips}}" wx:key="id" class="trip-option {{selectedTripIds.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleCreateTrip"><view class="trip-cover" style="background:{{item.cover_image ? '#dfe2e8' : '#243451'}}"></view><view class="trip-option-copy"><text>{{item.title}}</text><text>{{item.start_date || '日期待定'}} · {{item.place_count || 0}} 个地点</text></view><text class="trip-check">{{selectedTripIds.indexOf(item.id) >= 0 ? '✓' : '○'}}</text></view></scroll-view><text wx:else class="trip-empty">暂无可关联行程</text><button class="primary" bindtap="submitCreate">创建</button></view></view>
</view>
