<view class="page"><view class="top"><text class="back" bindtap="back">‹</text><view><text class="title">{{collection.name || collection.title || '收藏'}}</text><text class="sub">{{places.length}} 个地点</text></view></view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty error">{{error}}</view><scroll-view wx:else scroll-y class="feed"><view wx:if="{{!places.length}}" class="empty">这个清单还没有地点</view><view wx:for="{{places}}" wx:key="id" class="place" data-index="{{index}}" bindtap="openMap"><view class="place-icon">⌖</view><view class="copy"><text class="name">{{item.name}}</text><text class="address">{{item.address || '暂无地址'}}</text></view><text>›</text></view></scroll-view><bottom-nav active="atlas" /></view>
