.page{min-height:100vh;background:#f4f2ed;color:#16161b;padding-bottom:170rpx}.top{display:flex;align-items:center;gap:18rpx;padding:34rpx 32rpx 22rpx;background:rgba(255,255,255,.72)}.back{font-size:58rpx;line-height:1}.title{display:block;font-size:36rpx;font-weight:800}.sub{display:block;margin-top:6rpx;color:#858b95;font-size:22rpx}.feed{height:calc(100vh - 140rpx);padding:24rpx 32rpx;box-sizing:border-box}.detail-card{padding:34rpx 30rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:30rpx;background:rgba(255,255,255,.84);box-shadow:0 16rpx 38rpx rgba(20,25,35,.08)}.place-symbol{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:26rpx;background:#111118;color:#fff;font-size:48rpx}.place-name{display:block;margin-top:22rpx;font-size:42rpx;font-weight:800}.status{display:inline-block;margin-top:14rpx;padding:8rpx 18rpx;border-radius:24rpx;background:#ece9ff;color:#6255c9;font-size:22rpx}.address,.description,.contact{display:block;margin-top:20rpx;color:#777983;font-size:25rpx;line-height:1.55}.description{white-space:pre-wrap;color:#35363d}.contact text{display:block;margin-top:8rpx}.primary{margin:28rpx 0 0;color:#fff;background:#111118;border-radius:18rpx}.section-title{margin:30rpx 0 14rpx;color:#777983;font-size:23rpx;font-weight:700}.place{display:flex;align-items:center;gap:16rpx;margin:14rpx 0;padding:22rpx;border:1rpx solid #e3e5e9;border-radius:22rpx;background:rgba(255,255,255,.7)}.place-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:18rpx;background:#ecebf0;font-size:32rpx}.copy{flex:1;min-width:0}.name,.address{display:block}.name{font-size:27rpx;font-weight:700}.address{margin-top:6rpx;color:#8a909a;font-size:21rpx}.empty{text-align:center;padding:100rpx 30rpx;color:#858b95}.error{color:#c83e4f}
.labels{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:18rpx}.labels text{padding:7rpx 14rpx;border-radius:20rpx;background:#edf4ff;color:#4f6a9a;font-size:20rpx}
