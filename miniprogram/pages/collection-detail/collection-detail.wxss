.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;gap:18rpx;padding:36rpx 32rpx 28rpx;background:#fff}.back{font-size:60rpx;line-height:1}.title{display:block;font-size:38rpx;font-weight:900}.sub{display:block;margin-top:8rpx;color:#7a818c;font-size:22rpx}.feed{height:calc(100vh - 150rpx);padding:24rpx 32rpx;box-sizing:border-box}.place{display:flex;align-items:center;gap:18rpx;margin:16rpx 0;padding:24rpx;border-radius:26rpx;background:#fff;border:1rpx solid #e3e5e9}.place-icon{width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:20rpx;background:#e0e5ff;color:#545ee5;font-size:38rpx}.copy{flex:1}.name{display:block;font-size:30rpx;font-weight:800}.address{display:block;margin-top:8rpx;color:#7d838d;font-size:22rpx}.empty{padding:180rpx 30rpx;text-align:center;color:#8a909b}.error{color:#d04455}
