.page { min-height: 100vh; padding: 24rpx; box-sizing: border-box; }
.search-row { display: flex; gap: 16rpx; align-items: center; }
.search-input { flex: 1; height: 76rpx; padding: 0 24rpx; box-sizing: border-box; background: #fff; border-radius: 16rpx; }
.search-button { width: 150rpx; margin: 0; color: #fff; background: #1aad70; font-size: 28rpx; }
.error { display: block; margin: 18rpx 4rpx; color: #e53e3e; font-size: 24rpx; }
.map { width: 100%; height: 620rpx; margin-top: 24rpx; border-radius: 20rpx; overflow: hidden; }
.result { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.result-copy { min-width: 0; flex: 1; }
.save-button { flex: 0 0 auto; margin: 0 0 0 18rpx; padding: 0 18rpx; color: #1aad70; background: #edf9f3; font-size: 23rpx; }
.name { display: block; font-size: 30rpx; font-weight: 600; }
.address { display: block; margin-top: 10rpx; color: #718096; font-size: 24rpx; }
