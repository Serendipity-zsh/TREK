.page{position:relative;min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#dfe4e5;color:#17171b}.map-title{position:absolute;top:62rpx;right:100rpx;left:100rpx;z-index:4;padding:18rpx;border-radius:40rpx;background:rgba(255,255,255,.86);font-size:32rpx;font-weight:700;text-align:center}.top-bar{position:relative;z-index:5;display:flex;align-items:center;height:92rpx}.brand-tile{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:24rpx;background:#101013;color:#fff;font-size:38rpx}.top-spacer{flex:1}.top-icon{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;margin-left:12rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:34rpx}.search-row{position:relative;z-index:4;display:flex;gap:10rpx;margin-top:18rpx}.search-input{flex:1;padding:22rpx 24rpx;border-radius:18rpx;background:rgba(255,255,255,.92);font-size:25rpx}.search-button{margin:0;color:#fff;background:#101013;font-size:25rpx}.error{position:relative;z-index:4;display:block;margin:16rpx 0;color:#d33f58;font-size:23rpx}.map{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;filter:saturate(.6) brightness(1.08)}.route-row{position:relative;z-index:4;margin-top:18rpx}.route-button{margin:0;color:#111;background:rgba(255,255,255,.86);font-size:24rpx}.route-summary{display:block;margin-top:12rpx;padding:14rpx;border-radius:14rpx;background:rgba(255,255,255,.86);font-size:22rpx}.result{position:relative;z-index:4;display:flex;align-items:center;gap:16rpx;margin-top:12rpx;padding:20rpx;border-radius:18rpx;background:rgba(255,255,255,.9)}.result-copy{flex:1;min-width:0}.name{display:block;font-size:27rpx;font-weight:650}.address{display:block;margin-top:7rpx;color:#777;font-size:21rpx}.save-button{margin:0;color:#111;background:#edf0f0;font-size:21rpx}.quick-links{position:relative;z-index:4;margin-top:26vh;padding:18rpx;border-radius:28rpx;background:rgba(255,255,255,.86)}.quick-links view{display:flex;align-items:center;gap:18rpx;padding:28rpx 18rpx;border-bottom:1rpx solid #e9e9e9;font-size:30rpx}.quick-links view:last-child{border-bottom:0}.quick-links text:nth-of-type(1){flex:1;font-weight:650}.quick-links text:last-child{color:#888;font-size:40rpx}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:45rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
