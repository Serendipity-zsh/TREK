<view class="page">
  <view class="top-bar"><view class="top-icon" bindtap="goHome">‹</view><view class="brand-tile">✦</view><view class="top-spacer"></view><view class="top-icon">•••</view></view>
  <view wx:if="{{loading}}" class="loading">正在加载行程…</view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <block wx:if="{{trip && !loading}}">
    <view class="trip-header"><text class="eyebrow">TREK / 行程</text><text class="title">{{trip.title}}</text><text class="muted">{{trip.start_date || '未设置日期'}}{{trip.end_date ? ' — ' + trip.end_date : ''}}</text><view class="trip-actions"><text bindtap="editTrip">编辑</text><text bindtap="removeTrip">删除</text></view></view>
    <scroll-view class="trip-tabs" scroll-x><view class="tab {{activeTab === 'plan' ? 'active' : ''}}" data-tab="plan" bindtap="switchTab">计划</view><view class="tab {{activeTab === 'map' ? 'active' : ''}}" data-tab="map" bindtap="switchTab">地图</view><view class="tab {{activeTab === 'transports' ? 'active' : ''}}" data-tab="transports" bindtap="switchTab">交通</view><view class="tab {{activeTab === 'bookings' ? 'active' : ''}}" data-tab="bookings" bindtap="switchTab">预订</view><view class="tab {{activeTab === 'lists' ? 'active' : ''}}" data-tab="lists" bindtap="switchTab">清单</view><view class="tab {{activeTab === 'costs' ? 'active' : ''}}" data-tab="costs" bindtap="switchTab">费用</view><view class="tab {{activeTab === 'files' ? 'active' : ''}}" data-tab="files" bindtap="switchTab">文件</view><view class="tab {{activeTab === 'collab' ? 'active' : ''}}" data-tab="collab" bindtap="switchTab">协作</view></scroll-view>
    <block wx:if="{{activeTab === 'plan'}}">
    <view class="toolbar"><button bindtap="openMap">地图</button><button bindtap="addDay">添加一天</button></view>
    <view class="quick-tools"><button bindtap="openTools" data-tab="todo">待办</button><button bindtap="openTools" data-tab="packing">行李</button><button bindtap="openTools" data-tab="budget">预算</button><button bindtap="openTools" data-tab="reservations">预订</button><button bindtap="openTools" data-tab="weather">天气</button></view>
    <view wx:if="{{!days.length}}" class="card empty">还没有日期安排，点击“添加一天”开始规划。</view>
      <view wx:for="{{days}}" wx:key="id" class="day-card {{selectedDayId == item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectDay">
      <view class="day-head" data-id="{{item.id}}" catchtap="openDayActions"><view><text class="day-title">{{item.title || ('第 ' + item.day_number + ' 天')}}</text><text class="muted">{{item.date || '日期待定'}}{{item.notes ? ' · ' + item.notes : ''}}</text></view><button class="small-danger" data-id="{{item.id}}" catchtap="removeDay">删除</button></view>
      <view wx:if="{{!item.assignments.length}}" class="day-empty">还没有地点</view>
      <view wx:for="{{item.assignments}}" wx:for-item="assignment" wx:key="id" class="assignment" data-day-id="{{item.id}}" data-place-id="{{assignment.place_id || assignment.placeId}}" bindtap="openAssignmentMenu"><view class="pin"></view><view class="assignment-copy"><text class="assignment-name">{{assignment.place_name}}</text><text class="muted">{{assignment.address || '已加入当天计划'}}</text></view><text class="assignment-remove" data-day-id="{{item.id}}" data-id="{{assignment.id}}" catchtap="removeAssignment">×</text></view>
      <button class="add-place" data-id="{{item.id}}" catchtap="openPlacePicker">+ 添加地点</button>
    </view>
    </block>
    <block wx:elif="{{activeTab === 'transports' || activeTab === 'bookings'}}">
      <view class="section-head"><text>{{activeTab === 'transports' ? '交通' : '预订'}}</text><button bindtap="addReservation">＋ 添加</button></view><view wx:if="{{tabLoading}}" class="card empty">正在加载…</view>
      <view wx:elif="{{!tabItems.length}}" class="card empty">还没有{{activeTab === 'transports' ? '交通' : '预订'}}记录，可在更多工具中添加。</view>
      <view wx:for="{{tabItems}}" wx:key="id" class="record-card" data-index="{{index}}" bindtap="editReservation"><view class="record-copy"><text class="record-title">{{item.title || item.name || '未命名记录'}}</text><text class="muted">{{item.start_date || item.date || item.location || item.type || '已添加到行程'}}</text></view><text class="file-remove" data-index="{{index}}" catchtap="removeReservation">×</text></view>
      <button class="tool-link" bindtap="openTools" data-tab="reservations">打开预订与旅行工具</button>
    </block>
    <block wx:elif="{{activeTab === 'lists' || activeTab === 'costs'}}"><view wx:if="{{activeTab === 'lists'}}" class="list-switch"><button class="{{listKind === 'todo' ? 'active' : ''}}" data-kind="todo" bindtap="switchListKind">待办</button><button class="{{listKind === 'packing' ? 'active' : ''}}" data-kind="packing" bindtap="switchListKind">行李</button></view><view wx:if="{{activeTab === 'costs'}}" class="cost-summary">总费用 <text>¥ {{listTotal}}</text></view><view wx:if="{{tabLoading}}" class="card empty">正在加载…</view><view wx:elif="{{!listItems.length}}" class="card empty">这里还没有内容。</view><view wx:for="{{listItems}}" wx:key="id" class="record-card inline-record"><view wx:if="{{activeTab === 'lists'}}" class="inline-check {{item.checked ? 'checked' : ''}}" data-index="{{index}}" catchtap="toggleInlineItem">{{item.checked ? '✓' : ''}}</view><view class="inline-copy"><text class="record-title {{item.checked ? 'done' : ''}}">{{item.name || item.title}}</text><text class="muted">{{activeTab === 'costs' ? '¥ ' + (item.total_price || 0) : (item.category || '未分类')}}</text></view><text wx:if="{{activeTab === 'lists'}}" class="delete-note" data-index="{{index}}" catchtap="removeInlineItem">删除</text></view><button class="tool-link" bindtap="addInlineItem">＋ 添加{{activeTab === 'costs' ? '费用' : '项目'}}</button></block>
    <block wx:elif="{{activeTab === 'collab'}}"><view class="collab-tabs"><text class="collab-tab {{collabTab === 'chat' ? 'active' : ''}}" data-tab="chat" bindtap="switchCollab">聊天</text><text class="collab-tab {{collabTab === 'notes' ? 'active' : ''}}" data-tab="notes" bindtap="switchCollab">笔记</text><text class="collab-tab {{collabTab === 'polls' ? 'active' : ''}}" data-tab="polls" bindtap="switchCollab">投票</text></view><view wx:if="{{tabLoading}}" class="card empty">正在加载…</view><block wx:elif="{{collabTab === 'chat'}}"><scroll-view scroll-y class="chat-feed"><view wx:if="{{!collabMessages.length}}" class="empty">还没有消息，先打个招呼吧。</view><view wx:for="{{collabMessages}}" wx:key="id" class="chat-row"><view class="chat-avatar">{{item.avatarText}}</view><view class="chat-bubble"><view class="chat-meta">{{item.username || '旅行成员'}} · {{item.created_at || ''}}</view><text>{{item.text}}</text><text class="delete-note" data-index="{{index}}" catchtap="removeChatMessage">删除</text></view></view></scroll-view><view class="chat-compose"><input value="{{chatInput}}" placeholder="发送一条消息" bindinput="inputChat" confirm-type="send" bindconfirm="sendChat"/><button bindtap="sendChat">发送</button></view></block><block wx:elif="{{collabTab === 'notes'}}"><view class="section-head"><text>协作笔记</text><button bindtap="addCollabNote">＋ 新建</button></view><view wx:if="{{!collabNotes.length}}" class="card empty">还没有协作笔记。</view><view wx:for="{{collabNotes}}" wx:key="id" class="record-card"><text class="record-title">{{item.title || '旅行笔记'}}</text><text class="muted">{{item.content || item.body}}</text><text class="delete-note" data-index="{{index}}" bindtap="removeCollabNote">删除</text></view></block><block wx:else><view class="section-head"><text>投票</text><button bindtap="createPoll">＋ 新建</button></view><view wx:if="{{!collabPolls.length}}" class="card empty">还没有投票。</view><view wx:for="{{collabPolls}}" wx:for-index="pollIndex" wx:key="id" class="poll-card"><view class="poll-head"><text class="record-title">{{item.question}}</text><text class="poll-state">{{item.is_closed ? '已结束' : '进行中'}}</text></view><view wx:for="{{item.options}}" wx:key="index" class="poll-option" data-poll-index="{{pollIndex}}" data-option-index="{{index}}" bindtap="votePoll"><text>{{item.text || item.label}}</text><text>{{item.voters.length || 0}} 票</text></view><view class="poll-actions"><text wx:if="{{!item.is_closed}}" data-index="{{pollIndex}}" bindtap="closePoll">结束投票</text><text class="delete-note" data-index="{{pollIndex}}" bindtap="deletePoll">删除</text></view></view></block></block>
    <block wx:elif="{{activeTab === 'files'}}"><view class="section-head"><text>行程文件</text><button bindtap="uploadFile">{{uploadingFile ? '上传中…' : '＋ 上传'}}</button></view><view wx:if="{{tabLoading}}" class="card empty">正在加载…</view><view wx:elif="{{!files.length}}" class="card empty">还没有附件。</view><view wx:for="{{files}}" wx:key="id" class="record-card file-record"><view class="file-copy"><text class="record-title">{{item.original_name || item.name || '未命名文件'}}</text><text class="muted">{{item.mime_type || item.type || '附件'}}</text></view><text class="file-star {{item.starred ? 'on' : ''}}" data-index="{{index}}" catchtap="toggleFileStar">{{item.starred ? '★' : '☆'}}</text><text class="file-remove" data-index="{{index}}" catchtap="removeFile">×</text></view></block>
  </block>
  <view wx:if="{{showPlacePicker}}" class="sheet-mask" catchtap="closePlacePicker"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>选择地点</text><text bindtap="closePlacePicker">关闭</text></view><view wx:if="{{!places.length}}" class="empty">请先在地图中搜索并保存地点。</view><view wx:for="{{places}}" wx:key="id" class="place-row" data-index="{{index}}" bindtap="addPlace"><text>{{item.name}}</text><text class="muted">{{item.address}}</text></view></view></view>
  <bottom-nav active="home" bind:create="openCreateMenu" />
</view>
