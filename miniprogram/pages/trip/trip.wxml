<view class="page">
  <view class="top-bar"><view class="top-icon" bindtap="goHome">‹</view><view class="brand-tile">✦</view><view class="top-spacer"></view><view class="top-icon">•••</view></view>
  <view wx:if="{{loading}}" class="loading">正在加载行程…</view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <block wx:if="{{trip && !loading}}">
    <view class="trip-header"><text class="eyebrow">TREK / 行程</text><text class="title">{{trip.title}}</text><text class="muted">{{trip.start_date || '未设置日期'}}{{trip.end_date ? ' — ' + trip.end_date : ''}}</text><view class="trip-actions"><text bindtap="editTrip">编辑</text><text bindtap="removeTrip">删除</text></view></view>
    <scroll-view class="trip-tabs" scroll-x><view class="tab {{activeTab === 'plan' ? 'active' : ''}}" data-tab="plan" bindtap="switchTab">计划</view><view class="tab {{activeTab === 'map' ? 'active' : ''}}" data-tab="map" bindtap="switchTab">地图</view><view class="tab {{activeTab === 'transports' ? 'active' : ''}}" data-tab="transports" bindtap="switchTab">交通</view><view class="tab {{activeTab === 'bookings' ? 'active' : ''}}" data-tab="bookings" bindtap="switchTab">预订</view><view class="tab {{activeTab === 'lists' ? 'active' : ''}}" data-tab="lists" bindtap="switchTab">清单</view><view class="tab {{activeTab === 'costs' ? 'active' : ''}}" data-tab="costs" bindtap="switchTab">费用</view></scroll-view>
    <block wx:if="{{activeTab === 'plan'}}">
    <view class="toolbar"><button bindtap="openMap">地图</button><button bindtap="addDay">添加一天</button></view>
    <view class="quick-tools"><button bindtap="openTools" data-tab="todo">待办</button><button bindtap="openTools" data-tab="packing">行李</button><button bindtap="openTools" data-tab="budget">预算</button><button bindtap="openTools" data-tab="reservations">预订</button><button bindtap="openTools" data-tab="weather">天气</button></view>
    <view wx:if="{{!days.length}}" class="card empty">还没有日期安排，点击“添加一天”开始规划。</view>
    <view wx:for="{{days}}" wx:key="id" class="day-card {{selectedDayId == item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectDay">
      <view class="day-head"><view><text class="day-title">第 {{item.day_number}} 天</text><text class="muted">{{item.date || '日期待定'}}</text></view><button class="small-danger" data-id="{{item.id}}" catchtap="removeDay">删除</button></view>
      <view wx:if="{{!item.assignments.length}}" class="day-empty">还没有地点</view>
      <view wx:for="{{item.assignments}}" wx:key="id" class="assignment"><view class="pin"></view><view><text class="assignment-name">{{item.place_name}}</text><text class="muted">{{item.address || '已加入当天计划'}}</text></view></view>
      <button class="add-place" data-id="{{item.id}}" catchtap="openPlacePicker">+ 添加地点</button>
    </view>
    </block>
    <block wx:elif="{{activeTab === 'transports' || activeTab === 'bookings'}}">
      <view wx:if="{{tabLoading}}" class="card empty">正在加载…</view>
      <view wx:elif="{{!tabItems.length}}" class="card empty">还没有{{activeTab === 'transports' ? '交通' : '预订'}}记录，可在更多工具中添加。</view>
      <view wx:for="{{tabItems}}" wx:key="id" class="record-card"><text class="record-title">{{item.title || item.name || '未命名记录'}}</text><text class="muted">{{item.start_date || item.date || item.type || '已添加到行程'}}</text></view>
      <button class="tool-link" bindtap="openTools" data-tab="reservations">打开预订与旅行工具</button>
    </block>
    <block wx:elif="{{activeTab === 'lists' || activeTab === 'costs'}}"><view class="card empty">该工作区保留 TREK 的原有分类与数据，点击下方进入完整工具页。</view><button class="tool-link" bindtap="openTools" data-tab="{{activeTab === 'lists' ? 'todo' : 'budget'}}">打开{{activeTab === 'lists' ? '清单' : '费用'}}工具</button></block>
  </block>
  <view wx:if="{{showPlacePicker}}" class="sheet-mask" catchtap="closePlacePicker"><view class="sheet" catchtap="noop"><view class="sheet-head"><text>选择地点</text><text bindtap="closePlacePicker">关闭</text></view><view wx:if="{{!places.length}}" class="empty">请先在地图中搜索并保存地点。</view><view wx:for="{{places}}" wx:key="id" class="place-row" data-index="{{index}}" bindtap="addPlace"><text>{{item.name}}</text><text class="muted">{{item.address}}</text></view></view></view>
  <view class="bottom-nav"><view class="nav-item selected" bindtap="goHome">▦<text>行程</text></view><view class="nav-item" bindtap="goCalendar">▣<text>日历</text></view><view class="nav-add" bindtap="openMap">＋</view><view class="nav-item" bindtap="openMap">◎<text>探索</text></view><view class="nav-item" bindtap="openTools" data-tab="todo">•••<text>更多</text></view></view>
</view>
