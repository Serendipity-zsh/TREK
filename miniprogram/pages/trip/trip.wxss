page { background: #f7f8fa; }
.page { min-height: 100vh; padding: 42rpx 32rpx 70rpx; box-sizing: border-box; }
.trip-header { padding: 12rpx 6rpx 38rpx; }.eyebrow { display: block; color: #1aad70; font-size: 22rpx; letter-spacing: 3rpx; }.title { display: block; margin-top: 18rpx; color: #111827; font-size: 52rpx; font-weight: 700; }.muted { display: block; margin-top: 10rpx; color: #8b95a7; font-size: 24rpx; }.trip-actions { display: flex; gap: 28rpx; margin-top: 24rpx; }.trip-actions text { color: #1aad70; font-size: 24rpx; }.trip-actions text:last-child { color: #d14e4e; }
.toolbar { display: flex; gap: 18rpx; margin-bottom: 26rpx; }.toolbar button { flex: 1; margin: 0; color: #fff; background: #111827; font-size: 27rpx; }.toolbar button:first-child { color: #1aad70; background: #eaf8f1; }
.quick-tools { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 26rpx; }.quick-tools button { flex: 1 0 28%; margin: 0; padding: 0; color: #1aad70; background: #fff; font-size: 24rpx; }
.card, .day-card { margin-bottom: 22rpx; padding: 30rpx; background: #fff; border-radius: 22rpx; box-shadow: 0 10rpx 30rpx rgba(31,41,55,.05); }.day-card.selected { border: 2rpx solid #1aad70; }.day-head { display: flex; align-items: center; justify-content: space-between; }.day-title { display: block; color: #111827; font-size: 32rpx; font-weight: 650; }.small-danger { margin: 0; padding: 0 16rpx; color: #d14e4e; background: #fff2f2; font-size: 22rpx; }.day-empty { margin-top: 28rpx; padding: 22rpx; color: #9aa2b2; background: #f8fafc; border-radius: 12rpx; text-align: center; font-size: 24rpx; }.assignment { display: flex; gap: 20rpx; align-items: center; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0f4; }.pin { flex: 0 0 18rpx; width: 18rpx; height: 18rpx; background: #1aad70; border-radius: 50%; }.assignment-name { display: block; color: #1f2937; font-size: 29rpx; font-weight: 600; }.add-place { margin: 26rpx 0 0; color: #1aad70; background: #edf9f3; font-size: 25rpx; }.empty, .loading { padding: 70rpx 30rpx; color: #8b95a7; text-align: center; }.error { display: block; color: #d14e4e; font-size: 24rpx; }
.sheet-mask { position: fixed; z-index: 10; inset: 0; display: flex; align-items: flex-end; background: rgba(6,11,32,.45); }.sheet { width: 100%; max-height: 72vh; padding: 32rpx; box-sizing: border-box; background: #fff; border-radius: 28rpx 28rpx 0 0; }.sheet-head { display: flex; justify-content: space-between; margin-bottom: 26rpx; color: #111827; font-size: 32rpx; font-weight: 650; }.sheet-head text:last-child { color: #1aad70; font-size: 25rpx; font-weight: 400; }.place-row { padding: 24rpx 0; border-bottom: 1rpx solid #edf0f4; color: #1f2937; font-size: 28rpx; }
