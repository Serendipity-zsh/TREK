.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.top-bar{display:flex;align-items:center;gap:14rpx;height:92rpx}.top-icon,.brand-tile{display:flex;align-items:center;justify-content:center;width:70rpx;height:70rpx;border-radius:24rpx;background:rgba(255,255,255,.8);font-size:34rpx}.brand-tile{background:#101013;color:#fff}.top-spacer{flex:1}.loading,.empty{padding:70rpx 30rpx;color:#8b95a7;text-align:center}.error{display:block;color:#d14e4e;font-size:24rpx}.trip-header{margin:34rpx 6rpx 30rpx;padding:30rpx;border-radius:28rpx;background:rgba(255,255,255,.8)}.eyebrow{display:block;color:#777;font-size:22rpx;letter-spacing:2rpx}.title{display:block;margin-top:16rpx;color:#111827;font-size:48rpx;font-weight:750}.muted{display:block;margin-top:10rpx;color:#8b95a7;font-size:24rpx}.trip-actions{display:flex;gap:28rpx;margin-top:24rpx}.trip-actions text{color:#1aad70;font-size:24rpx}.trip-actions text:last-child{color:#d14e4e}.toolbar{display:flex;gap:18rpx;margin-bottom:26rpx}.toolbar button{flex:1;margin:0;color:#fff;background:#111827;font-size:27rpx}.toolbar button:first-child{color:#1aad70;background:#eaf8f1}.quick-tools{display:flex;flex-wrap:wrap;gap:14rpx;margin-bottom:26rpx}.quick-tools button{flex:1 0 28%;margin:0;padding:0;color:#1aad70;background:#fff;font-size:24rpx}.card,.day-card{margin-bottom:22rpx;padding:30rpx;background:rgba(255,255,255,.78);border-radius:24rpx;box-shadow:0 10rpx 30rpx rgba(31,41,55,.05)}.day-card.selected{border:2rpx solid #1aad70}.day-head{display:flex;align-items:center;justify-content:space-between}.day-title{display:block;color:#111827;font-size:32rpx;font-weight:650}.small-danger{margin:0;padding:0 16rpx;color:#d14e4e;background:#fff2f2;font-size:22rpx}.day-empty{margin-top:28rpx;padding:22rpx;color:#9aa2b2;background:#f8fafc;border-radius:12rpx;text-align:center;font-size:24rpx}.assignment{display:flex;gap:20rpx;align-items:center;margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid #edf0f4}.pin{flex:0 0 18rpx;width:18rpx;height:18rpx;background:#1aad70;border-radius:50%}.assignment-name{display:block;color:#1f2937;font-size:29rpx;font-weight:600}.add-place{margin:26rpx 0 0;color:#1aad70;background:#edf9f3;font-size:25rpx}.sheet-mask{position:fixed;z-index:10;inset:0;display:flex;align-items:flex-end;background:rgba(6,11,32,.45)}.sheet{width:100%;max-height:72vh;padding:32rpx;box-sizing:border-box;background:#fff;border-radius:28rpx 28rpx 0 0}.sheet-head{display:flex;justify-content:space-between;margin-bottom:26rpx;color:#111827;font-size:32rpx;font-weight:650}.sheet-head text:last-child{color:#1aad70;font-size:25rpx;font-weight:400}.place-row{padding:24rpx 0;border-bottom:1rpx solid #edf0f4;color:#1f2937;font-size:28rpx}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:56rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
.trip-tabs{display:flex;white-space:nowrap;margin:12rpx 0 22rpx;padding:8rpx;border-radius:42rpx;background:rgba(255,255,255,.58)}.tab{display:inline-block;padding:16rpx 25rpx;border-radius:32rpx;color:#74777e;font-size:24rpx}.tab.active{background:#111013;color:#fff}.record-card{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;padding:28rpx;border-radius:24rpx;background:rgba(255,255,255,.78)}.record-title{font-size:29rpx;font-weight:650}.tool-link{margin:24rpx 0;color:#fff;background:#111827;border-radius:18rpx;font-size:25rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:22rpx 0 14rpx;font-size:28rpx;font-weight:800}.section-head button{margin:0;padding:10rpx 18rpx;line-height:1.4;border-radius:22rpx;background:#111218;color:#fff;font-size:22rpx}.delete-note{display:block;margin-top:12rpx;color:#c53d55;font-size:21rpx}
.assignment-copy{flex:1;min-width:0}.assignment-remove{padding:14rpx;color:#c53d55;font-size:34rpx}
.list-switch{display:flex;gap:12rpx;margin:18rpx 0}.list-switch button{flex:1;margin:0;color:#777;background:#fff;font-size:24rpx}.list-switch button.active{color:#fff;background:#111218}.cost-summary{margin:18rpx 0;padding:24rpx;border-radius:22rpx;background:#fff;font-size:25rpx}.cost-summary text{float:right;font-weight:900}.inline-record{gap:14rpx}.inline-copy{flex:1;min-width:0}.inline-check{display:flex;align-items:center;justify-content:center;width:44rpx;height:44rpx;border:2rpx solid #aab1bb;border-radius:50%;color:#fff}.inline-check.checked{background:#1aad70;border-color:#1aad70}.done{text-decoration:line-through;color:#9299a4}
.file-record{gap:18rpx}.file-copy{flex:1;min-width:0}.file-star,.file-remove{padding:12rpx;font-size:34rpx}.file-star{color:#a5aab2}.file-star.on{color:#f2a900}.file-remove{color:#c53d55}
.record-copy{flex:1;min-width:0}
