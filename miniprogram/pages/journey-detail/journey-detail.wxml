<view class="page"><view class="hero"><text class="back" bindtap="back">‹</text><text class="hero-title">{{journey.title || '旅记'}}</text><text class="hero-sub">{{journey.subtitle || '记录旅程中的每一个片段'}}</text></view><view class="toolbar"><text>{{entries.length}} 篇记录</text><button bindtap="openCreate">＋ 添加记录</button></view><scroll-view scroll-y class="feed"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty error">{{error}}</view><view wx:elif="{{!entries.length}}" class="empty">还没有记录，开始写下第一篇吧。</view><view wx:for="{{entries}}" wx:key="id" class="entry"><view class="entry-date">{{item.date || item.created_at || '未设置日期'}}</view><text class="entry-title">{{item.title || '未命名记录'}}</text><text wx:if="{{item.body}}" class="entry-body">{{item.body}}</text><view class="entry-foot"><text>{{item.place_name || '旅程记录'}}</text><text class="delete" data-id="{{item.id}}" bindtap="removeEntry">删除</text></view></view></scroll-view><view class="bottom"><text>▦</text><text bindtap="openCreate" class="add">＋</text><text>◎</text></view><view wx:if="{{showCreate}}" class="mask" catchtap="closeCreate"><view class="sheet" catchtap="noop"><text class="sheet-title">添加记录</text><input placeholder="标题" bindinput="inputTitle" /><textarea placeholder="写下这段旅程…" bindinput="inputBody"></textarea><button class="primary" bindtap="submitCreate">保存</button></view></view></view>
