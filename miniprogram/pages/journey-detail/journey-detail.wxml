<view class="page">
  <view class="hero">
    <text class="back" bindtap="back">‹</text>
    <view class="hero-copy">
      <text class="hero-title">{{journey.title || '旅记'}}</text>
      <text class="hero-sub">{{journey.subtitle || '记录旅程中的每一个片段'}}</text>
    </view>
    <text class="hero-map" bindtap="openActions">•••</text>
  </view>
  <view class="toolbar">
    <text>{{view === 'gallery' ? gallery.length + ' 张照片' : entries.length + ' 篇记录'}}</text>
    <view class="view-switch">
      <text class="{{view === 'list' ? 'active' : ''}}" bindtap="showList">时间线</text>
      <text class="{{view === 'gallery' ? 'active' : ''}}" bindtap="showGallery">画廊</text>
      <text class="{{view === 'map' ? 'active' : ''}}" bindtap="showMap">地图</text>
    </view>
    <button bindtap="openCreate">＋ 添加记录</button>
    <button wx:if="{{view === 'gallery'}}" bindtap="openUpload">{{uploading ? '上传中…' : '上传照片'}}</button>
  </view>
  <map wx:if="{{view === 'map'}}" class="journey-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="3" markers="{{markers}}" enable-zoom enable-scroll></map>
  <scroll-view wx:elif="{{view === 'gallery'}}" scroll-y class="gallery-feed">
    <view wx:if="{{loading}}" class="empty">正在加载…</view>
    <view wx:elif="{{!gallery.length}}" class="empty">还没有照片，点击上方上传照片。</view>
    <view wx:for="{{gallery}}" wx:key="id" class="gallery-card" data-index="{{index}}" bindtap="openPhotoActions">
      <image wx:if="{{item.url || item.photo_url}}" class="gallery-image" src="{{item.url || item.photo_url}}" mode="aspectFill" />
      <view wx:elif="{{item.media_type === 'video'}}" class="gallery-placeholder video-placeholder">▶<text>视频{{item.durationLabel ? ' · ' + item.durationLabel : ''}}</text></view>
      <view wx:else class="gallery-placeholder">⌁</view>
      <view class="gallery-copy">
        <view class="gallery-caption-row"><text class="gallery-caption">{{item.caption || '旅程照片'}}</text><text class="gallery-more">•••</text></view>
        <text class="gallery-date">{{item.taken_at || item.created_at || '未设置日期'}}</text>
        <text class="gallery-meta">{{item.media_type === 'video' ? '视频' : '照片'}}{{item.lat ? ' · 已记录位置' : ''}}</text>
      </view>
    </view>
  </scroll-view>
  <scroll-view wx:else scroll-y class="feed">
    <view wx:if="{{loading}}" class="empty">正在加载…</view>
    <view wx:elif="{{error}}" class="empty error">{{error}}</view>
    <view wx:elif="{{!entries.length}}" class="empty">还没有记录，开始写下第一篇吧。</view>
    <view wx:for="{{entries}}" wx:key="id" class="entry {{activeId == item.id ? 'expanded' : ''}}" data-id="{{item.id}}" bindtap="selectEntry">
      <view class="entry-date">{{item.date || item.entry_date || item.created_at || '未设置日期'}}{{item.entry_time ? ' · ' + item.entry_time : ''}}</view>
      <text class="entry-title">{{item.title || '未命名记录'}}</text>
      <text wx:if="{{item.body}}" class="entry-body {{activeId == item.id ? 'show' : ''}}">{{item.body}}</text>
      <view wx:if="{{item.moodLabel || item.weatherLabel || item.tagsText}}" class="entry-meta"><text wx:if="{{item.moodLabel}}">心情 · {{item.moodLabel}}</text><text wx:if="{{item.weatherLabel}}">天气 · {{item.weatherLabel}}</text><text wx:if="{{item.tagsText}}">{{item.tagsText}}</text></view>
      <view wx:if="{{activeId == item.id && (item.prosText || item.consText)}}" class="entry-pros"><text wx:if="{{item.prosText}}">优点：{{item.prosText}}</text><text wx:if="{{item.consText}}">不足：{{item.consText}}</text></view>
      <view class="entry-foot"><text>{{item.place_name || '旅程记录'}}</text><text class="delete" data-id="{{item.id}}" catchtap="removeEntry">删除</text></view>
    </view>
  </scroll-view>
  <bottom-nav active="more" bind:create="openCreate" />
  <view wx:if="{{showCreate}}" class="mask" catchtap="closeCreate"><view class="sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">添加记录</text><text class="sheet-close" bindtap="closeCreate">×</text></view><input placeholder="标题" bindinput="inputTitle" /><view class="field-label">日期与时间</view><view class="date-time-row"><picker mode="date" value="{{entryDate}}" bindchange="changeEntryDate"><view class="entry-date-picker">{{entryDate || '选择日期'}}</view></picker><picker mode="time" value="{{entryTime}}" bindchange="changeEntryTime"><view class="entry-date-picker">{{entryTime || '时间（可选）'}}</view></picker></view><input placeholder="地点（可选）" bindinput="inputEntryLocation" /><view class="choice-row"><view bindtap="chooseMood">心情：{{moodText || '未设置'}}</view><view bindtap="chooseWeather">{{weatherText ? '天气：' + weatherText : '天气：未设置'}}</view></view><input placeholder="标签（用逗号分隔）" bindinput="inputEntryTags" /><textarea placeholder="写下这段旅程…" bindinput="inputBody"></textarea><view class="pros-cons-row"><input placeholder="优点（可选）" bindinput="inputEntryPros" /><input placeholder="不足（可选）" bindinput="inputEntryCons" /></view><button class="primary" bindtap="submitCreate">保存</button></view></view>
  <view wx:if="{{showSettings}}" class="mask" catchtap="closeSettings"><view class="sheet journey-settings" catchtap="noop"><view class="sheet-head"><text class="sheet-title">编辑旅记</text><text class="sheet-close" bindtap="closeSettings">×</text></view><input value="{{editTitle}}" placeholder="旅记标题" bindinput="inputEditTitle" /><input value="{{editSubtitle}}" placeholder="副标题" bindinput="inputEditSubtitle" /><view class="track-toggle"><view><text>显示行程轨迹</text><text>在旅记地图中显示关联行程路线</text></view><switch checked="{{showTripTracks}}" bindchange="toggleJourneyTracks" color="#111218" /></view><text class="trip-label">关联行程</text><scroll-view wx:if="{{availableTrips.length}}" scroll-y class="trip-options"><view wx:for="{{availableTrips}}" wx:key="id" class="trip-option {{selectedTripIds.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggleJourneyTrip"><view class="trip-option-copy"><text>{{item.title}}</text><text>{{item.start_date || '日期待定'}}</text></view><text class="trip-check">{{selectedTripIds.indexOf(item.id) >= 0 ? '✓' : '○'}}</text></view></scroll-view><text wx:else class="trip-empty">暂无可关联行程</text><button class="primary" bindtap="saveSettings">保存</button></view></view>
</view>
