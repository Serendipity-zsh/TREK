.page{min-height:100vh;background:#f5f6f8;color:#11151f}.hero{padding:36rpx 34rpx 42rpx;background:linear-gradient(135deg,#101421,#2b4369);color:#fff}.back{display:block;font-size:60rpx;line-height:1}.hero-title{display:block;margin-top:30rpx;font-size:48rpx;font-weight:900}.hero-sub{display:block;margin-top:14rpx;color:#d8e0ed;font-size:25rpx}.toolbar{display:flex;align-items:center;justify-content:space-between;padding:22rpx 32rpx;background:#fff;color:#707783;font-size:24rpx}.toolbar button{margin:0;padding:0 24rpx;height:68rpx;line-height:68rpx;border-radius:36rpx;background:#151722;color:#fff;font-size:23rpx}.feed{height:calc(100vh - 390rpx);padding:22rpx 32rpx 150rpx;box-sizing:border-box}.entry{margin:18rpx 0;padding:26rpx;border:1rpx solid #e3e5e9;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(20,25,35,.06)}.entry-date{color:#858b95;font-size:22rpx}.entry-title{display:block;margin-top:12rpx;font-size:32rpx;font-weight:800}.entry-body{display:block;margin-top:14rpx;color:#5e6570;font-size:26rpx;line-height:1.6}.entry-foot{display:flex;justify-content:space-between;margin-top:20rpx;color:#8a909b;font-size:22rpx}.delete{color:#d04455}.empty{padding:170rpx 30rpx;text-align:center;color:#8a909b}.error{color:#d04455}.bottom{position:fixed;left:32rpx;right:32rpx;bottom:24rpx;height:104rpx;border-radius:54rpx;background:rgba(255,255,255,.95);display:flex;align-items:center;justify-content:space-around;font-size:38rpx;box-shadow:0 15rpx 40rpx rgba(20,25,35,.14)}.bottom .add{width:82rpx;height:82rpx;line-height:75rpx;text-align:center;border-radius:50%;background:#111218;color:#fff;font-size:52rpx}.mask{position:fixed;inset:0;background:rgba(10,14,22,.42);display:flex;align-items:flex-end}.sheet{width:100%;padding:42rpx 36rpx 56rpx;border-radius:38rpx 38rpx 0 0;background:#fff;box-sizing:border-box}.sheet-title{display:block;margin-bottom:24rpx;font-size:36rpx;font-weight:800}.sheet input,.sheet textarea{width:100%;margin-bottom:18rpx;padding:22rpx;border:1rpx solid #dfe2e8;border-radius:20rpx;box-sizing:border-box}.sheet textarea{height:180rpx}.primary{background:#151722;color:#fff;border-radius:22rpx}
.hero{display:flex;align-items:center}.hero-copy{flex:1}.hero-map{font-size:42rpx}.view-switch{display:flex;padding:5rpx;border-radius:22rpx;background:#eef0f3}.view-switch text{padding:10rpx 14rpx;color:#777;font-size:21rpx}.view-switch text.active{border-radius:18rpx;background:#111218;color:#fff}.journey-map{width:100%;height:calc(100vh - 245rpx)}.entry.expanded{border:2rpx solid #1aad70}.entry-body{display:none}.entry-body.show{display:block}
.gallery-feed{height:calc(100vh - 390rpx);padding:22rpx 32rpx 150rpx;box-sizing:border-box}.gallery-card{margin:18rpx 0;overflow:hidden;border:1rpx solid #e3e5e9;border-radius:28rpx;background:#fff;box-shadow:0 10rpx 26rpx rgba(20,25,35,.06)}.gallery-image,.gallery-placeholder{display:block;width:100%;height:300rpx}.gallery-placeholder{display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#dce7f5,#f2ede4);color:#fff;font-size:100rpx}.gallery-copy{padding:20rpx 24rpx 24rpx}.gallery-date,.gallery-caption,.gallery-meta{display:block}.gallery-date{color:#858b95;font-size:21rpx}.gallery-caption{margin-top:9rpx;font-size:29rpx;font-weight:800}.gallery-meta{margin-top:8rpx;color:#8a909a;font-size:21rpx}
