.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.top-bar{display:flex;align-items:center;gap:16rpx;height:92rpx}.top-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:42rpx}.year-pill{display:flex;align-items:center;justify-content:space-between;flex:1;height:74rpx;padding:0 28rpx;border-radius:44rpx;background:rgba(255,255,255,.82);font-size:42rpx}.year{font-size:42rpx;font-weight:750}.person-card{display:flex;align-items:center;gap:20rpx;margin-top:28rpx;padding:28rpx;border-radius:28rpx;background:rgba(255,255,255,.72)}.avatar{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:50%;background:#5c55e9;color:#fff;font-size:34rpx;font-weight:700}.person-copy{flex:1}.person-name{display:block;font-size:32rpx;font-weight:700}.progress{height:16rpx;margin-top:18rpx;border-radius:12rpx;background:#f1f0f0}.remaining{display:block;margin-top:12rpx;color:#d5485d;font-size:25rpx}.stepper{display:flex;align-items:center;gap:20rpx}.stepper text:not(.days){display:flex;align-items:center;justify-content:center;width:62rpx;height:62rpx;border-radius:50%;background:#fff;font-size:36rpx}.days{color:#777;font-size:22rpx}.legend{display:flex;gap:20rpx;margin:26rpx 6rpx 18rpx}.legend text{flex:1;padding:16rpx;border-radius:30rpx;background:rgba(255,255,255,.65);color:#777;text-align:center;font-size:24rpx}.legend .legend-active{border:2rpx solid #6357ea;color:#25232b}.weekday-row{display:flex;justify-content:space-around;margin-bottom:8rpx;color:#888;font-size:22rpx}.month-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.month-card{padding:16rpx;border-radius:26rpx;background:rgba(255,255,255,.82)}.month-title{display:block;padding:18rpx;border-radius:22rpx;background:#f2f1ef;text-align:center;font-size:30rpx;font-weight:700}.week-row{display:flex;justify-content:space-around;margin-top:16rpx}.day{display:flex;align-items:center;justify-content:center;width:30rpx;height:30rpx;color:#5e5e63;font-size:21rpx}.blank{visibility:hidden}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:45rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
