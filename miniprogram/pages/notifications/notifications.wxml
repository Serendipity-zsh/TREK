<view class="page">
  <view class="top-bar"><view class="top-icon" bindtap="goHome">‹</view><view class="title-wrap"><text class="page-title">通知</text><text wx:if="{{unreadCount}}" class="unread-badge">{{unreadCount}}</text></view><view class="top-spacer"></view><text wx:if="{{unreadCount}}" class="header-action" bindtap="markAllRead">✓</text><text wx:if="{{total}}" class="header-action danger" bindtap="deleteAll">⌫</text></view>
  <view class="filter"><view class="filter-option {{!unreadOnly ? 'active' : ''}}" data-value="all" bindtap="toggleFilter">全部</view><view class="filter-option {{unreadOnly ? 'active' : ''}}" data-value="unread" bindtap="toggleFilter">未读</view></view>
  <text wx:if="{{error}}" class="error">{{error}}</text>
  <view class="notification-card">
    <view wx:if="{{loading && !items.length}}" class="empty">正在加载…</view>
    <view wx:elif="{{!loading && !items.length}}" class="empty"><view class="empty-mark">✦</view><text>暂时没有通知</text></view>
    <view wx:for="{{items}}" wx:key="id" class="notification {{item.is_read ? '' : 'unread'}}" data-index="{{index}}" bindtap="markRead"><view class="notice-icon">♧</view><view class="notice-copy"><text class="notice-title">{{item.title || item.title_key || 'TREK 通知'}}</text><text class="notice-body">{{item.body || item.text || item.text_key || '你有一条新的旅行通知'}}</text></view><view class="notice-actions"><text wx:if="{{!item.is_read}}" class="dot">●</text><text class="remove" catchtap="remove" data-index="{{index}}">⌫</text></view></view>
    <view wx:if="{{hasMore}}" class="load-more" bindtap="loadMore">{{loading ? '加载中…' : '加载更多'}}</view>
  </view>
  <bottom-nav active="more" bind:create="goHome" />
</view>
