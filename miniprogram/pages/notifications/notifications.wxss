.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.top-bar{display:flex;align-items:center;gap:18rpx;height:92rpx}.top-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:42rpx}.page-title{font-size:34rpx;font-weight:750}.top-spacer{flex:1}.header-action{padding:12rpx;color:#111;font-size:32rpx}.header-action.danger{color:#d33f58}.filter{display:flex;padding:8rpx;margin-top:28rpx;border-radius:44rpx;background:rgba(255,255,255,.7)}.filter-option{flex:1;padding:17rpx;border-radius:34rpx;color:#777;text-align:center;font-size:25rpx}.filter-option.active{background:#101013;color:#fff}.empty{padding:140rpx 20rpx;color:#8b8a8d;text-align:center;font-size:25rpx}.error{display:block;margin-top:18rpx;color:#d33f58;font-size:23rpx}.notification{display:flex;align-items:flex-start;gap:16rpx;margin-top:12rpx;padding:24rpx 18rpx;border-bottom:1rpx solid #e8e6e2;background:rgba(255,255,255,.68)}.notification.unread{background:rgba(255,255,255,.9)}.notice-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;flex:none;border-radius:18rpx;background:#ecebee;color:#666;font-size:30rpx}.notice-copy{flex:1;min-width:0}.notice-title{display:block;font-size:27rpx;font-weight:650}.notice-body{display:block;margin-top:8rpx;color:#777;font-size:22rpx;line-height:1.5}.notice-actions{display:flex;align-items:center;gap:12rpx}.dot{color:#111;font-size:17rpx}.remove{color:#aaa;font-size:26rpx}.bottom-nav{position:fixed;right:32rpx;bottom:24rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:108rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:58rpx;background:rgba(255,255,255,.94);box-shadow:0 14rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav-item text{font-size:20rpx}.nav-add{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;margin-top:-42rpx;border-radius:50%;background:#111218;color:#fff;font-size:52rpx}
