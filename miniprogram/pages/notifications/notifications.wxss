.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.top-bar{display:flex;align-items:center;gap:18rpx;height:92rpx}.top-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:42rpx}.title-wrap{display:flex;align-items:center;gap:10rpx;min-width:0}.page-title{font-size:34rpx;font-weight:750}.unread-badge{min-width:30rpx;padding:4rpx 9rpx;border-radius:20rpx;background:#12a979;color:#fff;text-align:center;font-size:20rpx;font-weight:700}.top-spacer{flex:1}.header-action{padding:12rpx;color:#111;font-size:32rpx}.header-action.danger{color:#d33f58}.filter{display:flex;padding:8rpx;margin-top:28rpx;border-radius:44rpx;background:rgba(255,255,255,.7)}.filter-option{flex:1;padding:17rpx;border-radius:34rpx;color:#777;text-align:center;font-size:25rpx}.filter-option.active{background:#101013;color:#fff}.error{display:block;margin-top:18rpx;color:#d33f58;font-size:23rpx}.notification-card{overflow:hidden;margin-top:24rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:28rpx;background:rgba(255,255,255,.58);box-shadow:0 10rpx 30rpx rgba(40,38,34,.05)}.empty{display:flex;min-height:520rpx;align-items:center;justify-content:center;flex-direction:column;padding:60rpx 20rpx;color:#8b8a8d;text-align:center;font-size:25rpx}.empty-mark{display:flex;align-items:center;justify-content:center;width:96rpx;height:96rpx;margin-bottom:22rpx;border-radius:30rpx;background:#ecebee;color:#999;font-size:42rpx}.notification{display:flex;align-items:flex-start;gap:16rpx;padding:24rpx 18rpx;border-bottom:1rpx solid #e8e6e2;background:rgba(255,255,255,.68)}.notification.unread{background:rgba(255,255,255,.9)}.notice-icon{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;flex:none;border-radius:18rpx;background:#ecebee;color:#666;font-size:30rpx}.notice-copy{flex:1;min-width:0}.notice-heading{display:flex;align-items:baseline;gap:12rpx}.notice-title{display:block;flex:1;min-width:0;font-size:27rpx;font-weight:650}.notice-time{flex:none;color:#aaa;font-size:19rpx}.notice-body{display:block;margin-top:8rpx;color:#777;font-size:22rpx;line-height:1.5}.notice-buttons{display:flex;gap:12rpx;margin-top:14rpx}.notice-buttons button{margin:0;border:1rpx solid #d9d7d2;border-radius:28rpx;background:#fff;color:#28282d;font-size:21rpx;line-height:1.9}.notice-buttons button:first-child{border-color:#12a979;color:#07835d}.notice-buttons button::after{border:0}.notice-actions{display:flex;align-items:center;gap:12rpx}.dot{color:#111;font-size:17rpx}.remove{color:#aaa;font-size:26rpx}.load-more{padding:28rpx;color:#777;text-align:center;font-size:23rpx}.bottom-nav{position:fixed;right:32rpx;bottom:24rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:108rpx;border:1rpx solid rgba(255,255,255,.9);border-radius:58rpx;background:rgba(255,255,255,.94);box-shadow:0 14rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav-item text{font-size:20rpx}.nav-add{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;margin-top:-42rpx;border-radius:50%;background:#111218;color:#fff;font-size:52rpx}
