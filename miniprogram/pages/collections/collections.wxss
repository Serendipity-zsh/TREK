.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;padding:38rpx 32rpx 24rpx;background:#fff}.title{font-size:42rpx;font-weight:900;flex:1}.top-actions{padding:14rpx 26rpx;border-radius:30rpx;background:#eef0f3;color:#555c68;font-size:24rpx}.feed{height:calc(100vh - 170rpx);padding:22rpx 32rpx 180rpx;box-sizing:border-box}.collection{display:flex;align-items:center;gap:20rpx;margin:18rpx 0;padding:26rpx;border:1rpx solid #e2e4e8;border-radius:28rpx;background:rgba(255,255,255,.86)}.collection-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:24rpx;background:#dce3ff;color:#555ee8;font-size:48rpx}.collection-copy{flex:1}.collection-title{display:block;font-size:31rpx;font-weight:800}.muted{display:block;margin-top:10rpx;color:#7b818c;font-size:22rpx}.empty{padding:180rpx 30rpx;text-align:center;color:#8a909b}.error{color:#d04455}.detail{margin:26rpx 32rpx;padding:30rpx;border-radius:30rpx;background:#fff}.detail-title{display:block;margin-bottom:20rpx;font-size:36rpx;font-weight:800}.place{padding:22rpx 0;border-top:1rpx solid #eef0f2}.bottom{position:fixed;left:32rpx;right:32rpx;bottom:24rpx;display:flex;align-items:center;justify-content:space-around;height:112rpx;border:1rpx solid #e3e5e9;border-radius:58rpx;background:rgba(255,255,255,.94);box-shadow:0 15rpx 40rpx rgba(20,25,35,.12)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav text{font-size:20rpx}.nav.active{color:#11151f}
