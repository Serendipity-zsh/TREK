.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;gap:12rpx;padding:38rpx 32rpx 24rpx;background:#fff}.list-switch{display:flex;align-items:center;gap:8rpx;flex:1;min-width:0}.title{font-size:39rpx;font-weight:900;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.chevron{color:#777;font-size:30rpx}.top-actions,.top-add,.top-edit{padding:14rpx 18rpx;border-radius:30rpx;background:#eef0f3;color:#555c68;font-size:24rpx}.top-add{padding:8rpx 20rpx;color:#fff;background:#111218;font-size:32rpx}.top-edit{padding:13rpx 10rpx;background:transparent;color:#555c68}.danger-edit{color:#c53d55}.list-menu{position:absolute;z-index:8;top:124rpx;left:32rpx;right:32rpx;padding:10rpx;border-radius:24rpx;background:rgba(255,255,255,.96);box-shadow:0 20rpx 50rpx rgba(0,0,0,.16)}.menu-item{display:flex;justify-content:space-between;padding:22rpx 18rpx;border-radius:16rpx;font-size:25rpx}.menu-item:active{background:#f1f2f5}.create-item{color:#1aad70}.filter-bar{display:flex;align-items:center;gap:10rpx;margin:18rpx 32rpx 0;padding:10rpx;border-radius:20rpx;background:rgba(255,255,255,.78)}.filter-bar input{flex:1;height:62rpx;padding:0 16rpx;border-radius:14rpx;background:#f3f4f6;font-size:23rpx}.filter-chip{padding:16rpx 13rpx;border-radius:18rpx;color:#777;font-size:21rpx}.filter-chip.active{color:#fff;background:#111218}.filter-chip.add-place{color:#1aad70;background:#e7f8ef}.collection-map{width:100%;height:calc(100vh - 310rpx)}.feed{height:calc(100vh - 170rpx);padding:22rpx 32rpx 180rpx;box-sizing:border-box}.detail-feed{height:calc(100vh - 270rpx)}.collection{display:flex;align-items:center;gap:20rpx;margin:18rpx 0;padding:26rpx;border:1rpx solid #e2e4e8;border-radius:28rpx;background:rgba(255,255,255,.86)}.collection-icon{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;border-radius:24rpx;background:#dce3ff;color:#555ee8;font-size:48rpx}.collection-copy{flex:1}.collection-title{display:block;font-size:31rpx;font-weight:800}.muted{display:block;margin-top:10rpx;color:#7b818c;font-size:22rpx}.empty{padding:180rpx 30rpx;text-align:center;color:#8a909b}.error{color:#d04455}.place{display:flex;align-items:center;gap:18rpx;padding:24rpx;margin:14rpx 0;border-radius:24rpx;background:#fff;border:1rpx solid #e2e4e8}.place-icon{width:68rpx;height:68rpx;line-height:68rpx;text-align:center;border-radius:20rpx;background:#e0e5ff;color:#545ee5;font-size:34rpx}.copy{flex:1}.name{display:block;font-size:28rpx;font-weight:800}.address{display:block;margin-top:8rpx;color:#7d838d;font-size:22rpx}.place-status{display:block;margin-top:8rpx;color:#1aad70;font-size:20rpx}.remove{padding:12rpx;color:#c53d55;font-size:34rpx}.bottom{position:fixed;left:32rpx;right:32rpx;bottom:24rpx;display:flex;align-items:center;justify-content:space-around;height:112rpx;border:1rpx solid #e3e5e9;border-radius:58rpx;background:rgba(255,255,255,.94);box-shadow:0 15rpx 40rpx rgba(20,25,35,.12)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#747a84;font-size:28rpx}.nav text{font-size:20rpx}.nav.active{color:#11151f}.nav-add{display:flex;align-items:center;justify-content:center;width:90rpx;height:90rpx;margin-top:-44rpx;border-radius:50%;background:#111218;color:#fff;font-size:54rpx;box-shadow:0 10rpx 22rpx rgba(0,0,0,.2)}.sheet-mask{position:fixed;z-index:20;inset:0;background:rgba(18,22,30,.38);display:flex;align-items:flex-end}.add-sheet{width:100%;max-height:76vh;padding:28rpx 32rpx 170rpx;box-sizing:border-box;border-radius:34rpx 34rpx 0 0;background:#f9fafb;box-shadow:0 -16rpx 50rpx rgba(0,0,0,.18)}.sheet-head{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:900}.sheet-close{font-size:44rpx;color:#777}.sheet-caption{display:block;margin:12rpx 0 18rpx;color:#7c838d;font-size:22rpx}.add-search{display:flex;gap:12rpx}.add-search input{flex:1;height:78rpx;padding:0 20rpx;border-radius:18rpx;background:#fff;border:1rpx solid #e1e4e8;font-size:25rpx}.add-search button{width:140rpx;height:78rpx;line-height:78rpx;padding:0;border-radius:18rpx;background:#111218;color:#fff;font-size:24rpx}.add-results{height:48vh;margin-top:18rpx}.small{padding:70rpx 20rpx}.add-result{display:flex;align-items:center;gap:16rpx;padding:22rpx 8rpx;border-bottom:1rpx solid #e7e9ed}.result-icon{width:64rpx;height:64rpx;line-height:64rpx;text-align:center;border-radius:18rpx;background:#e0e5ff;color:#545ee5;font-size:34rpx}.result-copy{flex:1;min-width:0}.result-name{display:block;font-size:27rpx;font-weight:800}.result-address{display:block;margin-top:7rpx;color:#7d838d;font-size:21rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.result-add{color:#1aad70;font-size:34rpx}
.label-menu{position:relative;z-index:8;margin:12rpx 0;padding:20rpx;border-radius:22rpx;background:rgba(255,255,255,.96);box-shadow:0 14rpx 34rpx rgba(20,25,35,.12)}.label-menu-head{display:flex;justify-content:space-between;font-size:27rpx;font-weight:800}.label-menu-head text:last-child{color:#1aad70;font-weight:650}.label-clear{margin-top:14rpx;color:#777;font-size:22rpx}.label-row{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid #eceef1}.label-select{display:flex;align-items:center;gap:12rpx;flex:1;color:#555;font-size:25rpx}.label-select text{width:18rpx;height:18rpx;border-radius:50%}.label-select.selected{color:#111;font-weight:700}.label-delete{padding:10rpx;color:#c53d55;font-size:30rpx}.place-labels{display:flex;gap:8rpx;margin-top:8rpx}.place-labels text{padding:4rpx 10rpx;border-radius:14rpx;background:#eef0ff;color:#4f56be;font-size:19rpx}.place-manage{display:block;margin-top:6rpx;color:#5363d8;font-size:20rpx}
