<view class="page"><view class="top"><view class="list-switch" bindtap="toggleMenu"><text class="title">{{active ? active.name || active.title : '收藏'}}</text><text class="chevron">⌄</text></view><view class="top-actions" bindtap="toggleView">{{view === 'list' ? '地图' : '列表'}}</view><view class="top-add" bindtap="createList">＋</view></view>
  <view wx:if="{{menuOpen}}" class="list-menu"><view class="menu-item" bindtap="toggleMenu">全部收藏</view><view wx:for="{{collections}}" wx:key="id" class="menu-item" data-id="{{item.id}}" bindtap="selectCollection">{{item.name || item.title}}<text>{{item.place_count || 0}}</text></view><view class="menu-item create-item" bindtap="createList">＋ 新建清单</view></view>
  <view wx:if="{{active}}" class="filter-bar"><input placeholder="搜索地点" value="{{query}}" bindinput="inputSearch"/><view class="filter-chip {{status === 'all' ? 'active' : ''}}" data-status="all" bindtap="setStatus">全部</view><view class="filter-chip {{status === 'planned' ? 'active' : ''}}" data-status="planned" bindtap="setStatus">计划</view><view class="filter-chip {{status === 'visited' ? 'active' : ''}}" data-status="visited" bindtap="setStatus">已去</view></view>
  <map wx:if="{{active && view === 'map'}}" class="collection-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="4" markers="{{markers}}" show-location enable-zoom enable-scroll></map>
  <scroll-view wx:elif="{{active}}" scroll-y class="feed detail-feed"><view wx:if="{{!visiblePlaces.length}}" class="empty">这个清单还没有匹配的地点</view><view wx:for="{{visiblePlaces}}" wx:key="id" class="place" data-index="{{index}}" bindtap="openMap"><view class="place-icon">⌖</view><view class="copy"><text class="name">{{item.name}}</text><text class="address">{{item.address || '暂无地址'}}</text></view><text class="remove" catchtap="removePlace" data-index="{{index}}">×</text></view></scroll-view>
  <scroll-view wx:else scroll-y class="feed"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty error">{{error}}</view><view wx:elif="{{!collections.length}}" class="empty">还没有收藏清单，点击右上角创建一个</view><view wx:for="{{collections}}" wx:key="id" class="collection" data-id="{{item.id}}" bindtap="selectCollection"><view class="collection-icon">⌑</view><view class="collection-copy"><text class="collection-title">{{item.name || item.title}}</text><text class="muted">{{item.place_count || 0}} 个地点</text></view><text>›</text></view></scroll-view><view class="bottom"><view class="nav" bindtap="openHome">▦<text>行程</text></view><view class="nav" bindtap="openCalendar">▣<text>日历</text></view><view class="nav-add" bindtap="createList">＋</view><view class="nav active" bindtap="openAtlas">◎<text>探索</text></view><view class="nav" bindtap="openMore">•••<text>更多</text></view></view></view>
