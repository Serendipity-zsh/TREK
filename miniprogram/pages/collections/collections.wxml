<view class="page"><view class="top"><text class="title">收藏</text><view class="top-actions"><text bindtap="toggleView">{{view === 'list' ? '地图' : '列表'}}</text></view></view><view wx:if="{{active}}" class="detail"><text class="detail-title">{{active.name || active.title}}</text><view wx:for="{{places}}" wx:key="id" class="place"><text>{{item.name}}</text><text class="muted">{{item.address || '暂无地址'}}</text></view></view><scroll-view wx:else scroll-y class="feed"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty error">{{error}}</view><view wx:elif="{{!collections.length}}" class="empty">还没有收藏清单</view><view wx:for="{{collections}}" wx:key="id" class="collection" data-id="{{item.id}}" bindtap="selectCollection"><view class="collection-icon">⌑</view><view class="collection-copy"><text class="collection-title">{{item.name || item.title}}</text><text class="muted">{{item.place_count || 0}} 个地点</text></view><text>›</text></view></scroll-view><view class="bottom"><view class="nav active">▦<text>收藏</text></view><view class="nav" bindtap="openMap">◎<text>探索</text></view><view class="nav" bindtap="openMore">•••<text>更多</text></view></view></view>
