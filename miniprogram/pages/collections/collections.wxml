<view class="page"><view class="top"><view class="list-switch" bindtap="toggleMenu"><text class="title">{{active ? active.name || active.title : '收藏'}}</text><text class="chevron">⌄</text></view><view wx:if="{{active}}" class="top-edit" bindtap="editActiveCollection">✎</view><view wx:if="{{active}}" class="top-edit" bindtap="shareActiveCollection">♧</view><view wx:if="{{active}}" class="top-edit danger-edit" bindtap="deleteActiveCollection">⌫</view><view class="top-actions" bindtap="toggleView">{{view === 'list' ? '地图' : '列表'}}</view><view class="top-add" bindtap="createList">＋</view></view>
  <view wx:if="{{menuOpen}}" class="list-menu"><view class="menu-item" bindtap="toggleMenu">全部收藏</view><view wx:for="{{collections}}" wx:key="id" class="menu-item" data-id="{{item.id}}" bindtap="selectCollection">{{item.name || item.title}}<text>{{item.place_count || 0}}</text></view><view class="menu-item create-item" bindtap="createList">＋ 新建清单</view></view>
  <view wx:if="{{active}}" class="filter-bar"><input placeholder="搜索地点" value="{{query}}" bindinput="inputSearch"/><view class="filter-chip {{status === 'all' ? 'active' : ''}}" data-status="all" bindtap="setStatus">全部</view><view class="filter-chip {{status === 'idea' ? 'active' : ''}}" data-status="idea" bindtap="setStatus">有兴趣</view><view class="filter-chip {{status === 'want' ? 'active' : ''}}" data-status="want" bindtap="setStatus">想去</view><view class="filter-chip {{status === 'visited' ? 'active' : ''}}" data-status="visited" bindtap="setStatus">已去</view><view wx:if="{{labels.length}}" class="filter-chip {{labelFilter.length ? 'active' : ''}}" bindtap="toggleLabelMenu">标签{{labelFilter.length ? ' ' + labelFilter.length : ''}}</view><view class="filter-chip" bindtap="toggleSelectMode">{{selectMode ? '完成' : '选择'}}</view><view class="filter-chip add-place" bindtap="openAddPlace">＋ 地点</view></view>
  <view wx:if="{{selectMode && active}}" class="bulk-bar"><text bindtap="selectAllVisible">{{selectedIds.length ? '取消全选' : '全选当前结果'}}</text><text>已选 {{selectedIds.length}}</text><text class="bulk-danger" bindtap="deleteSelectedPlaces">删除</text></view>
  <view wx:if="{{labelMenu}}" class="label-menu"><view class="label-menu-head"><text>标签筛选</text><text bindtap="createLabel">＋ 新建</text></view><view wx:if="{{labelFilter.length}}" class="label-clear" bindtap="clearLabelFilter">清除筛选</view><view wx:for="{{labels}}" wx:key="id" class="label-row"><view class="label-select {{labelFilter.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="filterByLabel"><text style="background:{{item.color || '#6366f1'}}"></text>{{item.name}}</view><text class="label-delete" data-index="{{index}}" bindtap="deleteLabel">×</text></view></view>
  <map wx:if="{{active && view === 'map'}}" class="collection-map" latitude="{{mapLatitude}}" longitude="{{mapLongitude}}" scale="4" markers="{{markers}}" show-location enable-zoom enable-scroll></map>
  <scroll-view wx:elif="{{active}}" scroll-y class="feed detail-feed"><view wx:if="{{!visiblePlaces.length}}" class="empty">这个清单还没有匹配的地点</view><view wx:for="{{visiblePlaces}}" wx:key="id" class="place" data-index="{{index}}" bindtap="{{selectMode ? 'togglePlaceSelection' : 'openPlace'}}"><text wx:if="{{selectMode}}" class="select-mark {{selectedIds.indexOf(item.id) >= 0 ? 'selected' : ''}}" data-index="{{index}}">{{selectedIds.indexOf(item.id) >= 0 ? '✓' : ''}}</text><view class="place-main"><view class="place-icon">{{item.category_name ? '✦' : '⌖'}}</view><view class="copy"><text class="name">{{item.name}}</text><text wx:if="{{item.address}}" class="address">⌖ {{item.address}}</text><view wx:if="{{item.label_names.length}}" class="place-labels"><text wx:for="{{item.label_names}}" wx:for-item="labelName" wx:key="*this">{{labelName}}</text></view></view></view><view class="place-side"><text wx:if="{{!selectMode}}" class="status-pill status-{{item.status}}" catchtap="setPlaceStatus" data-index="{{index}}">{{item.status === 'visited' ? '✓ 已去' : (item.status === 'want' ? '◉ 想去' : '○ 有兴趣')}}</text><text wx:if="{{item.category_name}}" class="category-pill" style="color:{{item.category_color}};background:{{item.category_color}}18">✦ {{item.category_name}}</text></view><text wx:if="{{!selectMode}}" class="remove" catchtap="removePlace" data-index="{{index}}">×</text></view></scroll-view>
  <scroll-view wx:else scroll-y class="feed"><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:elif="{{error}}" class="empty error">{{error}}</view><view wx:elif="{{!collections.length}}" class="empty">还没有收藏清单，点击右上角创建一个</view><view wx:for="{{collections}}" wx:key="id" class="collection" data-id="{{item.id}}" bindtap="selectCollection"><view class="collection-icon">⌑</view><view class="collection-copy"><text class="collection-title">{{item.name || item.title}}</text><text class="muted">{{item.place_count || 0}} 个地点</text></view><text>›</text></view></scroll-view>
  <view wx:if="{{showAdd}}" class="sheet-mask" catchtap="closeAddPlace"><view class="add-sheet" catchtap="noop"><view class="sheet-head"><text>加入地点</text><text class="sheet-close" bindtap="closeAddPlace">×</text></view><text class="sheet-caption">搜索高德地点并保存到「{{active.name || active.title}}」</text><view class="add-search"><input focus placeholder="例如：东京塔" value="{{addQuery}}" bindinput="inputAddQuery" confirm-type="search" bindconfirm="searchAddPlace"/><button bindtap="searchAddPlace">搜索</button></view><scroll-view scroll-y class="add-results"><view wx:if="{{addLoading}}" class="empty small">正在搜索…</view><view wx:elif="{{!addResults.length}}" class="empty small">输入关键词搜索地点</view><view wx:for="{{addResults}}" wx:key="index" class="add-result" data-index="{{index}}" bindtap="saveAddPlace"><view class="result-icon">⌖</view><view class="result-copy"><text class="result-name">{{item.name || item.title}}</text><text class="result-address">{{item.address || item.adname || item.district || '暂无地址'}}</text></view><text class="result-add">＋</text></view></scroll-view></view></view>
  <bottom-nav active="more" bind:create="openAddPlace" />
</view>
