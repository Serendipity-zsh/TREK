<view class="page">
  <view wx:if="{{!loggedIn}}" class="login-shell">
    <view class="login-hero">
      <view class="hero-content">
        <view class="logo-mark"><text>+</text><text>+</text><text>+</text></view>
        <text class="brand">trek</text>
        <text class="hero-title">你的旅行。你的计划。</text>
      </view>
    </view>

    <view class="login-panel">
      <view class="login-card">
        <text class="card-title">登录</text>
        <text class="card-copy">欢迎回来</text>
        <text class="field-label">登录方式</text>
        <view class="fake-field">◎ <text>微信账号</text></view>
        <text class="field-label">账号状态</text>
        <view class="fake-field">◉ <text>使用微信安全登录</text></view>
        <button class="primary" loading="{{loading}}" bindtap="handleLogin">微信登录</button>
        <button wx:if="{{devTools}}" class="dev-login" loading="{{loading}}" bindtap="handleDemoLogin">✈ 试用演示——无需注册</button>
        <text class="privacy-copy">首次登录会自动创建 TREK 账号</text>
        <text wx:if="{{error}}" class="error">{{error}}</text>
      </view>
    </view>
  </view>

  <block wx:else>
    <view class="app-shell">
      <view class="top-bar">
        <view class="brand-tile"><text>✦</text></view>
        <view class="top-spacer"></view>
        <view class="top-icon" bindtap="openNotifications">♧</view>
        <view class="avatar" bindtap="toggleUserMenu">{{avatarText}}</view>
      </view>
      <view wx:if="{{menuOpen}}" class="user-menu" catchtap="noop">
        <view class="menu-profile"><view class="avatar menu-avatar">{{avatarText}}</view><view><text class="menu-name">{{user.username || 'Demo User'}}</text><text class="menu-email">微信用户</text></view></view>
        <view class="menu-row" bindtap="openSettings">☷ <text>设置</text></view>
        <view class="menu-row" bindtap="openSettings">☼ <text>颜色模式</text><text class="menu-value">浅色</text></view>
        <view class="menu-divider"></view>
        <view class="menu-row danger" bindtap="handleLogout">⇥ <text>退出登录</text></view>
      </view>
      <view wx:if="{{welcomeOpen}}" class="welcome-mask" catchtap="dismissWelcome"><view class="welcome-modal" catchtap="noop"><view class="welcome-brand"><view class="brand-tile">✦</view><text>欢迎来到 trek</text></view><text class="welcome-copy">你可以查看、编辑和创建旅行。所有更改都会在每小时自动重置。</text><view class="welcome-info"><view><text class="welcome-info-icon">◷</text><text>下次重置将在 9 分钟后</text></view><view><text class="welcome-info-icon">⇧</text><text>演示模式下已禁用文件上传</text></view></view><view class="welcome-description"><text class="description-title">⌖ 什么是 TREK？</text><text>一个支持实时协作、交互式地图、OIDC 登录和深色模式的自托管旅行规划器。</text></view><text class="welcome-modules-title">模块化附加组件（完整版本可禁用）</text><view class="welcome-modules"><view><text>▣ Vacay</text><text>带日历、节假日和用户融合的假期规划器</text></view><view><text>◎ Atlas</text><text>带已访问国家和旅行统计的世界地图</text></view><view><text>☷ Packing</text><text>按旅行管理清单</text></view><view><text>▤ Budget</text><text>支持分摊的费用追踪</text></view><view><text>▧ Documents</text><text>将文件附加到旅行</text></view><view><text>⇄ Widgets</text><text>货币换算和时区工具</text></view></view><button class="welcome-dismiss" bindtap="dismissWelcome">知道了</button></view></view>
      <view wx:if="{{featuredTrip}}" class="hero-trip card" data-id="{{featuredTrip.id}}" bindtap="openTrip">
        <image wx:if="{{featuredTrip.cover_image}}" class="hero-cover" src="{{featuredTrip.cover_image}}" mode="aspectFill" />
        <view wx:else class="hero-cover fallback" style="background:{{featuredTrip.coverColor}}"></view>
        <view class="hero-shade"></view>
        <view class="hero-trip-top">
          <text class="trip-kicker">即将开始</text>
          <view class="hero-actions"><text catchtap="editFeaturedTrip">✎</text><text catchtap="copyFeaturedTrip">▣</text><text catchtap="archiveFeaturedTrip">⌫</text></view>
        </view>
        <text class="hero-title">{{featuredTrip.title}}</text>
        <view class="stat-row">
          <text class="stat-pill">▣ {{featuredTrip.day_count || 1}} 天</text>
          <text class="stat-pill">⌖ {{featuredTrip.place_count || 0}} 个目的地</text>
          <text class="stat-pill">♧ {{featuredTrip.traveler_count || 1}} 位旅客</text>
        </view>
      </view>
      <view class="filter-row">
        <view class="segmented">
          <text class="segment {{tripFilter === 'planned' ? 'active' : ''}}" data-filter="planned" bindtap="setTripFilter">已计划</text>
          <text class="segment {{tripFilter === 'archive' ? 'active' : ''}}" data-filter="archive" bindtap="setTripFilter">已归档</text>
          <text class="segment {{tripFilter === 'completed' ? 'active' : ''}}" data-filter="completed" bindtap="setTripFilter">已完成</text>
        </view>
        <view class="round-icon" bindtap="createTrip">＋</view>
        <view class="round-icon" bindtap="toggleViewMode">{{viewMode === 'grid' ? '☷' : '▦'}}</view>
      </view>
      <view wx:if="{{!trips.length}}" class="card empty">还没有行程，马上创建一个吧。</view>
      <view wx:for="{{visibleTrips}}" wx:key="id" data-id="{{item.id}}" bindtap="openTrip" class="card trip-card {{viewMode === 'list' ? 'list-card' : ''}}">
        <view class="trip-cover" style="background:{{item.cover_image ? 'transparent' : item.coverColor}}"><image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" /></view>
        <view class="trip-card-body"><view class="trip-card-head"><text class="trip-title">{{item.title}}</text><text class="trip-date">{{item.start_date || '待定'}}{{item.end_date ? ' → ' + item.end_date : ''}}</text></view>
        <view class="trip-card-line"><text class="trip-status">● {{item.status || '规划中'}}</text><text class="trip-place">{{item.place_count || 0}} 个目的地</text></view>
        <view wx:if="{{viewMode === 'list'}}" class="trip-stats"><text>{{item.day_count || 0}} 天</text><text>{{item.place_count || 0}} 地点</text><text>{{(item.shared_count || 0) + 1}} 位旅客</text></view></view>
      </view>
      <view wx:if="{{featuredTrip && !widgetLoading}}" class="dashboard-widgets">
        <view wx:if="{{showUpcoming}}" class="widget-card widget-wide"><view class="widget-head"><text class="widget-kicker">即将发生</text><text class="widget-arrow">›</text></view><view wx:if="{{!upcomingReservations.length}}" class="widget-copy">暂无近期预订 · 打开行程添加酒店、交通或活动</view><view wx:for="{{upcomingReservations}}" wx:key="id" class="upcoming-row"><view class="upcoming-icon">{{item.type === 'flight' ? '✈' : item.type === 'hotel' ? '⌂' : '●'}}</view><view class="upcoming-copy"><text class="widget-title">{{item.title || item.name || '旅行安排'}}</text><text class="widget-copy">{{item.start_date || item.date || item.reservation_time}}<text wx:if="{{item.trip_title}}"> · {{item.trip_title}}</text></text></view></view></view>
        <view wx:if="{{showCollections}}" class="widget-card widget-link" bindtap="openCollections"><view class="widget-head"><text class="widget-kicker">收藏清单</text><text class="widget-arrow">›</text></view><view wx:if="{{!collectionItems.length}}" class="widget-copy">还没有收藏清单</view><view wx:for="{{collectionItems}}" wx:key="id" class="collection-row"><text class="collection-name">{{item.name || item.title}}</text><text class="collection-count">{{item.place_count || item.count || 0}}</text></view></view>
        <view wx:if="{{showCurrency}}" class="widget-card"><view class="widget-head"><text class="widget-kicker">货币换算</text><text class="widget-arrow">↔</text></view><view class="currency-row"><text class="currency-amount">{{currencyAmount}} {{currencyFrom}}</text><text class="currency-equals">=</text><text class="currency-amount">{{currencyValue}} {{currencyTo}}</text></view><text class="widget-copy">{{currencyRate ? ('1 ' + currencyFrom + ' = ' + currencyRate + ' ' + currencyTo) : '汇率暂不可用'}}</text></view>
        <view wx:if="{{showTimezones}}" class="widget-card"><view class="widget-head"><text class="widget-kicker">时区</text><text class="widget-arrow">◷</text></view><view wx:for="{{timezoneCards}}" wx:key="zone" class="timezone-row"><text class="timezone-name">{{item.name}}</text><text class="timezone-time">{{item.time}}</text></view></view>
      </view>
      <view wx:if="{{createOpen}}" class="sheet-mask" catchtap="closeCreate">
        <view class="create-sheet" catchtap="noop">
          <view class="sheet-head"><text>新建行程</text><text class="sheet-close" bindtap="closeCreate">×</text></view>
          <text class="sheet-copy">先建立一个轻量的旅行骨架，之后可以继续补充地点、交通和预订。</text>
          <text class="sheet-label">行程名称</text><input class="sheet-input" focus placeholder="例如：日本秋日" value="{{createForm.title}}" data-field="title" bindinput="inputCreate" />
          <text class="sheet-label">日期</text>
          <view class="date-row"><picker mode="date" value="{{createForm.start_date}}" data-field="start_date" bindchange="changeCreateDate"><view class="date-input">{{createForm.start_date || '开始日期'}}</view></picker><text>→</text><picker mode="date" value="{{createForm.end_date}}" data-field="end_date" bindchange="changeCreateDate"><view class="date-input">{{createForm.end_date || '结束日期'}}</view></picker></view>
          <text class="sheet-label">简介（可选）</text><textarea class="sheet-textarea" placeholder="写下这次旅行的方向" value="{{createForm.description}}" data-field="description" bindinput="inputCreate" />
          <button class="sheet-primary" bindtap="submitCreate">创建行程</button>
        </view>
      </view>
      <bottom-nav active="home" bind:create="createTrip" />
    </view>
  </block>
</view>
