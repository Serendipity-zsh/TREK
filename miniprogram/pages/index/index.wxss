.page {
  min-height: 100vh;
  box-sizing: border-box;
}

.login-shell { min-height: 100vh; background: #f7f8fa; }
.login-hero {
  position: relative;
  min-height: 760rpx;
  overflow: hidden;
  background: radial-gradient(circle at 42% 28%, #25266e 0, #11153d 38%, #060b20 100%);
}
.dot-field {
  position: absolute;
  inset: 0;
  opacity: .55;
  background-image: radial-gradient(#7782bd 1.5rpx, transparent 1.5rpx);
  background-size: 20rpx 20rpx;
  mask-image: linear-gradient(145deg, #fff, transparent 76%);
}
.hero-content { position: absolute; left: 56rpx; right: 56rpx; bottom: 92rpx; color: #fff; }
.logo-mark { display: flex; align-items: center; gap: 5rpx; height: 66rpx; margin-bottom: 12rpx; }
.logo-mark text { display: block; width: 22rpx; height: 42rpx; color: #fff; background: #fff; font-size: 0; transform: skew(-18deg); }
.logo-mark text:nth-child(2) { height: 58rpx; margin-top: -18rpx; }
.brand { display: block; font-size: 96rpx; font-weight: 700; line-height: 1; letter-spacing: -3rpx; }
.hero-title { display: block; margin-top: 52rpx; font-size: 46rpx; font-weight: 650; letter-spacing: 2rpx; }
.hero-copy { display: block; margin-top: 24rpx; color: #b7bfd9; font-size: 25rpx; line-height: 1.7; }
.login-panel { padding: 42rpx 36rpx 70rpx; background: #f7f8fa; }
.card { margin-bottom: 24rpx; padding: 36rpx; background: #fff; border-radius: 24rpx; box-shadow: 0 10rpx 36rpx rgba(31, 41, 55, .06); }
.login-card { padding: 46rpx 38rpx 40rpx; }
.card-title { display: block; color: #111827; font-size: 42rpx; font-weight: 700; }
.card-copy { display: block; margin: 12rpx 0 58rpx; color: #9aa2b2; font-size: 27rpx; }
.primary { width: 100%; margin: 0; color: #fff; background: #101827; border-radius: 16rpx; font-size: 30rpx; }
.privacy-copy { display: block; margin-top: 24rpx; color: #9aa2b2; font-size: 23rpx; text-align: center; }
.error { margin-top: 24rpx; color: #e53e3e; font-size: 24rpx; word-break: break-all; }
.app-shell { min-height: 100vh; padding: 46rpx 36rpx 70rpx; box-sizing: border-box; background: #f7f8fa; }
.app-header { display: flex; align-items: center; justify-content: space-between; }
.app-brand { display: block; color: #101827; font-size: 56rpx; font-weight: 700; letter-spacing: -2rpx; }
.app-tagline { display: block; margin-top: 4rpx; color: #9aa2b2; font-size: 22rpx; }
.welcome-block { margin: 82rpx 4rpx 48rpx; }
.welcome { display: block; font-size: 32rpx; font-weight: 600; }
.muted { display: block; margin-top: 12rpx; color: #718096; font-size: 25rpx; }
.ghost { margin: 0; padding: 0 22rpx; color: #1aad70; background: #edf9f3; font-size: 25rpx; }
.section-title { margin: 42rpx 4rpx 20rpx; color: #1f2937; font-size: 32rpx; font-weight: 600; }
.empty { color: #718096; text-align: center; }
.trip-title { display: block; font-size: 32rpx; font-weight: 600; }
.map-entry { margin: 36rpx 0 0; color: #1aad70; background: #eaf8f1; }
