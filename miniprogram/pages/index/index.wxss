.page { min-height: 100vh; box-sizing: border-box; }
.login-shell { min-height: 100vh; background: #f7f8fa; }
.login-hero { position: relative; min-height: 390rpx; overflow: hidden; background: #f7f8fa; }
.hero-content { position: absolute; top: 82rpx; right: 56rpx; left: 56rpx; color: #101013; text-align: center; }
.logo-mark { display: flex; align-items: center; gap: 5rpx; height: 66rpx; margin-bottom: 12rpx; }
.logo-mark text { display: block; width: 22rpx; height: 42rpx; color: #101013; background: #101013; font-size: 0; transform: skew(-18deg); }
.logo-mark text:nth-child(2) { height: 58rpx; margin-top: -18rpx; }
.logo-mark { justify-content: center; }
.brand { display: block; font-size: 96rpx; font-weight: 700; line-height: 1; letter-spacing: -3rpx; }
.hero-title { display: block; margin-top: 40rpx; color: #9b9ca1; font-size: 38rpx; font-weight: 500; letter-spacing: 2rpx; }
.login-panel { padding: 42rpx 36rpx 70rpx; background: #f7f8fa; }
.card { margin-bottom: 24rpx; padding: 36rpx; background: rgba(255,255,255,.78); border: 1rpx solid rgba(255,255,255,.9); border-radius: 30rpx; box-shadow: 0 16rpx 44rpx rgba(31,41,55,.08); box-sizing: border-box; }
.login-card { padding: 46rpx 38rpx 40rpx; }
.card-title { display: block; color: #111827; font-size: 42rpx; font-weight: 700; }
.card-copy { display: block; margin: 12rpx 0 58rpx; color: #9aa2b2; font-size: 27rpx; }
.field-label { display: block; margin: 24rpx 0 12rpx; color: #292a30; font-size: 24rpx; font-weight: 650; text-align: left; }
.fake-field { display: flex; align-items: center; gap: 16rpx; height: 78rpx; padding: 0 22rpx; border: 2rpx solid #e3e3e7; border-radius: 20rpx; color: #a0a1a7; font-size: 28rpx; text-align: left; }
.fake-field text { color: #777983; font-size: 25rpx; }
.primary { width: 100%; margin: 0; color: #fff; background: #101827; border-radius: 16rpx; font-size: 30rpx; }
.dev-login { width: 100%; margin: 20rpx 0 0; color: #5c3100; background: #f6a000; border-radius: 16rpx; font-size: 27rpx; }
.privacy-copy { display: block; margin-top: 24rpx; color: #9aa2b2; font-size: 23rpx; text-align: center; }
.error { margin-top: 24rpx; color: #e53e3e; font-size: 24rpx; word-break: break-all; }
.app-shell { min-height: 100vh; padding: 36rpx 32rpx 170rpx; box-sizing: border-box; background: #f4f2ed; color: #141419; }
.top-bar { display: flex; align-items: center; height: 92rpx; padding: 0 18rpx; border: 1rpx solid rgba(255,255,255,.85); border-radius: 58rpx; background: rgba(255,255,255,.74); box-shadow: 0 18rpx 40rpx rgba(70,65,55,.08); }
.brand-tile { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 24rpx; background: #101013; color: #fff; font-size: 38rpx; }
.top-spacer { flex: 1; }
.top-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; margin-right: 14rpx; border-radius: 50%; background: #fff; font-size: 36rpx; }
.avatar { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border: 4rpx solid #fff; border-radius: 50%; background: #4c4c54; color: #fff; font-size: 30rpx; box-shadow: 0 8rpx 20rpx rgba(0,0,0,.2); }
.user-menu { position: absolute; top: 144rpx; right: 32rpx; z-index: 20; width: 480rpx; padding: 18rpx; border: 1rpx solid rgba(255,255,255,.9); border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 20rpx 50rpx rgba(0,0,0,.16); }
.menu-profile { display: flex; align-items: center; gap: 16rpx; padding: 10rpx; }
.menu-avatar { width: 76rpx; height: 76rpx; flex: none; }
.menu-name { display: block; font-size: 29rpx; font-weight: 700; }
.menu-email { display: block; margin-top: 6rpx; color: #888; font-size: 21rpx; }
.menu-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 14rpx; color: #202027; font-size: 29rpx; }
.menu-row text:first-of-type { flex: 1; }
.menu-value { color: #777; font-size: 22rpx; }
.menu-divider { height: 1rpx; margin: 0 12rpx; background: #ecebea; }
.menu-row.danger { color: #d33f58; }
.welcome-mask { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; padding: 30rpx; background: rgba(24,24,29,.62); }
.welcome-modal { width: 100%; padding: 34rpx; box-sizing: border-box; border-radius: 34rpx; background: rgba(255,255,255,.96); box-shadow: 0 24rpx 70rpx rgba(0,0,0,.3); }
.welcome-brand { display: flex; align-items: center; gap: 18rpx; font-size: 34rpx; font-weight: 750; }
.welcome-brand .brand-tile { width: 62rpx; height: 62rpx; }
.welcome-copy { display: block; margin-top: 24rpx; color: #777; font-size: 25rpx; line-height: 1.6; }
.welcome-info { display: flex; gap: 14rpx; margin-top: 24rpx; }
.welcome-info text { flex: 1; padding: 20rpx; border: 2rpx solid #bce6f1; border-radius: 20rpx; color: #207e9e; font-size: 21rpx; line-height: 1.5; }
.welcome-info text:last-child { border-color: #f1da8a; color: #a3691c; }
.welcome-description { margin-top: 18rpx; padding: 22rpx; border: 2rpx solid #e3e5ea; border-radius: 20rpx; color: #777; font-size: 23rpx; line-height: 1.55; }
.description-title { display: block; margin-bottom: 8rpx; color: #202127; font-size: 27rpx; font-weight: 700; }
.welcome-dismiss { margin-top: 26rpx; color: #fff; background: #101827; border-radius: 20rpx; }
.hero-trip { position: relative; min-height: 390rpx; margin-top: 52rpx; padding: 30rpx; overflow: hidden; background: linear-gradient(160deg, rgba(255,255,255,.68), rgba(234,231,225,.84)); }
.hero-cover, .hero-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
.hero-cover { z-index: 0; }
.hero-cover.fallback { background: linear-gradient(135deg, #1b2844, #315d55); }
.hero-shade { z-index: 1; background: linear-gradient(180deg, rgba(0,0,0,.1), rgba(0,0,0,.62)); }
.hero-trip > view, .hero-trip > text { position: relative; z-index: 2; }
.hero-trip-top { display: flex; align-items: center; justify-content: space-between; }
.trip-kicker { padding: 14rpx 24rpx; border-radius: 34rpx; background: #fff; font-size: 24rpx; font-weight: 650; }
.hero-actions { display: flex; gap: 12rpx; }
.hero-actions text { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: rgba(255,255,255,.55); color: #9ea0a3; font-size: 30rpx; }
.hero-title { display: block; margin-top: 190rpx; color: #fff; font-size: 48rpx; font-weight: 750; text-shadow: 0 2rpx 5rpx rgba(0,0,0,.15); }
.stat-row { display: flex; gap: 12rpx; margin-top: 26rpx; }
.stat-pill { padding: 12rpx 16rpx; border-radius: 30rpx; background: rgba(49,48,48,.48); color: #fff; font-size: 22rpx; }
.filter-row { display: flex; align-items: center; gap: 12rpx; margin: 30rpx 0 20rpx; }
.segmented { display: flex; flex: 1; padding: 8rpx; border-radius: 50rpx; background: rgba(255,255,255,.5); }
.segment { flex: 1; padding: 18rpx 8rpx; border-radius: 40rpx; color: #333; font-size: 24rpx; text-align: center; }
.segment.active { background: #101013; color: #fff; }
.round-icon { display: flex; align-items: center; justify-content: center; width: 70rpx; height: 70rpx; border-radius: 50%; background: rgba(255,255,255,.72); font-size: 34rpx; }
.empty { text-align: center; color: #718096; }
.trip-card { padding: 0; overflow: hidden; background: rgba(255,255,255,.62); }
.trip-cover { height: 150rpx; overflow: hidden; }
.trip-cover image { width: 100%; height: 100%; }
.trip-card-body { padding: 28rpx; }
.trip-card-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12rpx; }
.trip-title { display: block; max-width: 52%; overflow: hidden; font-size: 31rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.trip-date { padding: 10rpx 16rpx; border-radius: 30rpx; background: rgba(235,233,228,.9); color: #5c5b5a; font-size: 21rpx; white-space: nowrap; }
.trip-card-line { display: flex; justify-content: space-between; margin-top: 28rpx; color: #777; font-size: 23rpx; }
.trip-status { color: #777; }
.trip-stats { display: flex; justify-content: space-around; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(120,120,120,.12); color: #767676; font-size: 21rpx; }
.list-card { border-radius: 20rpx; }
.bottom-nav { position: fixed; right: 32rpx; bottom: 34rpx; left: 32rpx; z-index: 10; display: flex; align-items: center; justify-content: space-around; height: 106rpx; border: 1rpx solid rgba(255,255,255,.95); border-radius: 58rpx; background: rgba(255,255,255,.9); box-shadow: 0 12rpx 36rpx rgba(0,0,0,.12); }
.sheet-mask { position: fixed; inset: 0; z-index: 40; display: flex; align-items: flex-end; background: rgba(17,17,24,.44); }
.create-sheet { width: 100%; box-sizing: border-box; padding: 30rpx 34rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fff; box-shadow: 0 -18rpx 58rpx rgba(0,0,0,.2); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; font-size: 36rpx; font-weight: 800; }
.sheet-close { color: #8b8f99; font-size: 48rpx; font-weight: 400; line-height: 1; }
.sheet-copy { display: block; margin-top: 12rpx; color: #858b95; font-size: 23rpx; line-height: 1.5; }
.sheet-label { display: block; margin: 22rpx 0 10rpx; color: #32343a; font-size: 23rpx; font-weight: 700; }
.sheet-input,.date-input,.sheet-textarea { box-sizing: border-box; border: 2rpx solid #e5e6ea; border-radius: 18rpx; background: #fafafa; color: #17181c; font-size: 27rpx; }
.sheet-input { width: 100%; height: 78rpx; padding: 0 22rpx; }
.date-row { display: flex; align-items: center; gap: 14rpx; }
.date-row picker { flex: 1; }
.date-input { padding: 20rpx 14rpx; color: #777b84; text-align: center; }
.sheet-textarea { width: 100%; min-height: 120rpx; padding: 18rpx 22rpx; }
.sheet-primary { margin: 28rpx 0 0; color: #fff; background: #111118; border-radius: 18rpx; font-size: 29rpx; }
.nav-item { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 74rpx; color: #666; font-size: 30rpx; }
.nav-item text { margin-top: 5rpx; font-size: 18rpx; }
.nav-item.selected { color: #111; }
.nav-add { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; margin-top: -44rpx; border-radius: 50%; background: #101013; color: #fff; font-size: 56rpx; box-shadow: 0 12rpx 24rpx rgba(0,0,0,.22); }
