.page{min-height:100vh;background:#f5f6f8;color:#11151f}.top{display:flex;align-items:center;gap:12rpx;padding:34rpx 32rpx 20rpx}.circle{width:74rpx;height:74rpx;line-height:74rpx;text-align:center;border-radius:50%;background:#fff;border:1rpx solid #e2e4e8;color:#59606b;font-size:34rpx}.year{display:flex;align-items:center;justify-content:space-between;flex:1;height:74rpx;padding:0 20rpx;border-radius:40rpx;background:#fff;font-size:38rpx;font-weight:900}.year text:first-child,.year text:last-child{font-size:50rpx;font-weight:400}.person{display:flex;align-items:center;gap:18rpx;margin:12rpx 32rpx;padding:22rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e2e4e8}.person-avatar{width:82rpx;height:82rpx;line-height:82rpx;border-radius:50%;background:#5c5fe9;color:#fff;text-align:center;font-size:38rpx;font-weight:800}.person-copy{flex:1}.person-name{display:block;font-size:30rpx;font-weight:800}.progress{height:12rpx;margin:14rpx 0 8rpx;border-radius:8rpx;background:#edf0f3}.progress view{height:100%;border-radius:8rpx;background:#5c5fe9}.remaining{color:#d04455;font-size:22rpx}.stepper{display:flex;align-items:center;gap:10rpx}.stepper>text:first-child,.stepper>text:last-child{width:42rpx;height:42rpx;line-height:38rpx;text-align:center;border-radius:50%;background:#f0f1f3;color:#555;font-size:34rpx}.stepper>text:last-child{background:#111218;color:#fff}.allowance{font-size:32rpx;font-weight:900}.allowance small{font-size:18rpx;font-weight:400}.legend{display:flex;gap:22rpx;margin:12rpx 32rpx;color:#777e88;font-size:22rpx}.legend-active{color:#555ee5}.edit-tools{display:flex;gap:10rpx;margin:8rpx 32rpx;padding:8rpx;border-radius:24rpx;background:#fff;border:1rpx solid #e2e4e8}.mode{flex:1;padding:12rpx 6rpx;text-align:center;border-radius:18rpx;color:#777;font-size:20rpx}.mode.active{background:#111218;color:#fff}.mode.orange{background:#f97316}.feed{height:calc(100vh - 350rpx);padding:8rpx 32rpx 150rpx;box-sizing:border-box}.weekday{display:grid;grid-template-columns:repeat(7,1fr);padding:0 16rpx;color:#999fa8;font-size:20rpx;text-align:center}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx 16rpx}.month{padding:18rpx 14rpx 16rpx;border-radius:26rpx;background:#fff;border:1rpx solid #e2e4e8}.month-title{display:block;margin-bottom:12rpx;text-align:center;font-size:28rpx;font-weight:900}.week{display:grid;grid-template-columns:repeat(7,1fr);margin:6rpx 0}.day-wrap{height:38rpx;display:flex;align-items:center;justify-content:center}.day{width:34rpx;height:34rpx;line-height:34rpx;text-align:center;color:#4f5560;font-size:18rpx}.weekend{background:#f1f2f4;border-radius:8rpx;color:#989da5}.logged{background:#c8c5ff;color:#23206f;border-radius:9rpx;font-weight:800}.company{background:#f8e7bd;border-radius:9rpx}.selected{outline:3rpx solid #111218}.error{padding:0 32rpx;color:#d04455;font-size:22rpx}.bottom{position:fixed;left:32rpx;right:32rpx;bottom:24rpx;display:flex;align-items:center;justify-content:space-around;height:108rpx;border-radius:56rpx;background:rgba(255,255,255,.95);box-shadow:0 15rpx 40rpx rgba(20,25,35,.14)}.nav{display:flex;flex-direction:column;align-items:center;gap:4rpx;color:#777e88;font-size:28rpx}.nav text{font-size:20rpx}.nav.active{color:#11151f}.nav-add{width:84rpx;height:84rpx;line-height:77rpx;text-align:center;border-radius:50%;background:#111218;color:#fff;font-size:50rpx}
.editor{padding-bottom:24rpx}.month-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx;padding:12rpx 20rpx;border-radius:22rpx;background:#fff;font-size:30rpx;font-weight:900}.month-nav text:first-child,.month-nav text:last-child{font-size:48rpx;font-weight:400}.month-large{padding:26rpx 18rpx}.month-large .day-wrap{height:70rpx}.month-large .day{width:58rpx;height:58rpx;line-height:58rpx;font-size:24rpx}
