<view class="page">
  <view class="top"><view class="circle" bindtap="openInvite">♧+</view><view class="circle" bindtap="openShares">↗</view><view class="year"><text bindtap="previousYear">‹</text><text>{{year}}</text><text bindtap="nextYear">›</text></view><view class="circle" bindtap="openSettings">☷</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="person"><view class="person-avatar">{{userInitial}}</view><view class="person-copy"><text class="person-name">{{plan.name || '我的假期'}}</text><view class="progress"><view style="width:{{stats.percent || 0}}%"></view></view><text class="remaining">{{stats.remaining || 0}} 天剩余</text></view><view class="stepper"><text bindtap="adjustAllowance" data-delta="-1">−</text><text class="allowance">{{stats.vacation_days || stats.total_available || 0}}<small> 天</small></text><text bindtap="adjustAllowance" data-delta="1">＋</text></view></view>
  <view class="legend"><text class="legend-active">● {{plan.user_name || '我'}}</text><text>● 公司假期</text></view>
  <view wx:if="{{view === 'edit'}}" class="edit-tools"><text class="mode {{mode === 'vacation' ? 'active' : ''}}" data-mode="vacation" bindtap="changeMode">我的假期</text><text class="mode {{mode === 'company' ? 'active' : ''}}" data-mode="company" bindtap="changeMode">公司假期</text><text class="mode {{halfDay ? 'active orange' : ''}}" bindtap="toggleHalfDay">半天</text><text class="mode {{compDay ? 'active' : ''}}" bindtap="toggleCompDay">调休</text></view>
  <scroll-view scroll-y class="feed"><view class="weekday"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view>
    <view wx:if="{{view === 'grid'}}" class="grid"><view wx:for="{{months}}" wx:key="title" class="month"><text class="month-title" data-month="{{item.month}}" bindtap="openMonth">{{item.title}}</text><view wx:for="{{item.weeks}}" wx:for-item="week" wx:key="*this" class="week"><view wx:for="{{week}}" wx:for-item="cell" wx:key="*this" class="day-wrap"><text wx:if="{{cell}}" data-cell="{{cell}}" bindtap="dayTap" class="day {{cell.weekend ? 'weekend' : ''}} {{cell.logged ? 'logged' : ''}} {{cell.company ? 'company' : ''}} {{cell.selected ? 'selected' : ''}}">{{cell.day}}{{cell.half ? '·' : ''}}</text></view></view></view></view></view>
    <view wx:else class="editor"><view class="month-nav"><text bindtap="previousMonth">‹</text><text>{{editTitle}}</text><text bindtap="nextMonth">›</text></view><view class="month month-large"><view wx:for="{{months[editMonth].weeks}}" wx:for-item="week" wx:key="*this" class="week"><view wx:for="{{week}}" wx:for-item="cell" wx:key="*this" class="day-wrap"><text wx:if="{{cell}}" data-cell="{{cell}}" bindtap="dayTap" class="day {{cell.weekend ? 'weekend' : ''}} {{cell.logged ? 'logged' : ''}} {{cell.company ? 'company' : ''}} {{cell.selected ? 'selected' : ''}}">{{cell.day}}{{cell.half ? '·' : ''}}</text></view></view></view></view>
  </scroll-view>
  <view class="bottom"><view class="nav" bindtap="goHome">▦<text>行程</text></view><view class="nav active" bindtap="toggleView">▣<text>{{view === 'grid' ? '日历' : '编辑'}}</text></view><view class="nav-add" bindtap="toggleView">＋</view><view class="nav" bindtap="openTools">•••<text>更多</text></view></view>
</view>
