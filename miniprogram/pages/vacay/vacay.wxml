<view class="page"><view class="top"><view class="circle">♙</view><view class="circle">⌯</view><view class="year"><text bindtap="previousYear">‹</text><text>{{year}}</text><text bindtap="nextYear">›</text></view><view class="circle">☷</view></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="person"><view class="person-avatar">{{userInitial}}</view><view class="person-copy"><text class="person-name">{{plan.name || '我的假期'}}</text><view class="progress"><view style="width:{{stats.percent || 0}}%"></view></view><text class="remaining">{{stats.remaining || 0}} 天剩余</text></view><text class="allowance">{{stats.total_available || 0}}<small> 天</small></text></view><view class="legend"><text class="legend-active">● {{plan.user_name || '我'}}</text><text>● 公司假期</text></view><scroll-view scroll-y class="feed"><view class="weekday"><text wx:for="{{weekdays}}" wx:key="*this">{{item}}</text></view><view class="grid"><view wx:for="{{months}}" wx:key="title" class="month"><text class="month-title">{{item.title}}</text><view wx:for="{{item.weeks}}" wx:for-item="week" wx:key="*this" class="week"><text wx:for="{{week}}" wx:for-item="cell" wx:key="*this" class="day {{cell.weekend ? 'weekend' : ''}}">{{cell.day || ''}}</text></view></view></view></scroll-view><view class="bottom"><view class="nav" bindtap="goHome">▦<text>行程</text></view><view class="nav active">▣<text>日历</text></view><view class="nav-add">＋</view><view class="nav" bindtap="openTools">•••<text>更多</text></view></view></view>
