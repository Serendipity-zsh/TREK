.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.welcome-card{padding:34rpx;border-radius:28rpx;background:rgba(255,255,255,.84)}.welcome-brand{display:flex;align-items:center;gap:18rpx;font-size:34rpx;font-weight:750}.welcome-mark{display:flex;align-items:center;justify-content:center;width:60rpx;height:60rpx;border-radius:18rpx;background:#101013;color:#fff}.welcome-copy{display:block;margin-top:26rpx;color:#777;font-size:26rpx;line-height:1.65}.info-row{margin-top:20rpx;padding:28rpx;border:2rpx solid #e3e5ea;border-radius:24rpx;background:rgba(255,255,255,.7)}.info-title{display:block;font-size:30rpx;font-weight:700}.info-copy{display:block;margin-top:16rpx;color:#70757f;font-size:25rpx;line-height:1.6}.feature-label{display:block;margin:34rpx 6rpx 16rpx;font-size:27rpx;font-weight:700}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.feature-card{min-height:130rpx;padding:22rpx;border-radius:22rpx;background:rgba(255,255,255,.8)}.feature-card text:first-child{display:block;font-size:28rpx;font-weight:700}.feature-card text:last-child{display:block;margin-top:12rpx;color:#838890;font-size:21rpx;line-height:1.45}.settings-entry{margin-top:24rpx;color:#fff;background:#101827;border-radius:22rpx}.tabs{display:flex;gap:12rpx;margin-bottom:28rpx}.tabs button{flex:1;margin:0;color:#718096;background:#e9edf2;font-size:26rpx}.tabs button.active{color:#fff;background:#111827}.total{margin:18rpx 0 28rpx;padding:28rpx;color:#718096;background:#fff;border-radius:18rpx}.total text{float:right;color:#111827;font-size:34rpx;font-weight:700}.item{display:flex;align-items:center;gap:18rpx;margin-bottom:16rpx;padding:24rpx;background:#fff;border-radius:18rpx}.check{flex:0 0 38rpx;width:38rpx;height:38rpx;border:2rpx solid #cbd5e1;border-radius:50%;color:#fff;background:#fff;text-align:center;line-height:38rpx}.check.checked{border-color:#1aad70;background:#1aad70}.item-main{flex:1;min-width:0}.item-name{display:block;color:#1f2937;font-size:29rpx}.item-name.done{color:#9aa2b2;text-decoration:line-through}.item-meta{display:block;margin-top:8rpx;color:#9aa2b2;font-size:22rpx}.remove{color:#d14e4e;font-size:23rpx}.empty{padding:100rpx 20rpx;color:#9aa2b2;text-align:center}.error{display:block;margin-bottom:20rpx;color:#d14e4e;font-size:24rpx}.add{margin-top:30rpx;color:#1aad70;background:#eaf8f1}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:56rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
