page { background: #f7f8fa; }.page { min-height: 100vh; padding: 36rpx 32rpx 70rpx; box-sizing: border-box; }.tabs { display: flex; gap: 12rpx; margin-bottom: 28rpx; }.tabs button { flex: 1; margin: 0; color: #718096; background: #e9edf2; font-size: 26rpx; }.tabs button.active { color: #fff; background: #111827; }.total { margin: 18rpx 0 28rpx; padding: 28rpx; color: #718096; background: #fff; border-radius: 18rpx; }.total text { float: right; color: #111827; font-size: 34rpx; font-weight: 700; }.item { display: flex; align-items: center; gap: 18rpx; margin-bottom: 16rpx; padding: 24rpx; background: #fff; border-radius: 18rpx; }.check { flex: 0 0 38rpx; width: 38rpx; height: 38rpx; border: 2rpx solid #cbd5e1; border-radius: 50%; color: #fff; background: #fff; text-align: center; line-height: 38rpx; }.check.checked { border-color: #1aad70; background: #1aad70; }.item-main { flex: 1; min-width: 0; }.item-name { display: block; color: #1f2937; font-size: 29rpx; }.item-name.done { color: #9aa2b2; text-decoration: line-through; }.item-meta { display: block; margin-top: 8rpx; color: #9aa2b2; font-size: 22rpx; }.remove { color: #d14e4e; font-size: 23rpx; }.empty { padding: 100rpx 20rpx; color: #9aa2b2; text-align: center; }.error { display: block; margin-bottom: 20rpx; color: #d14e4e; font-size: 24rpx; }.add { margin-top: 30rpx; color: #1aad70; background: #eaf8f1; }
