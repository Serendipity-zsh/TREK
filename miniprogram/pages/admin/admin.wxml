<view class="page"><view class="top"><text class="back" bindtap="back">‹</text><view class="section-switch" bindtap="chooseSection"><text class="title">{{section === 'users' ? '用户管理' : (section === 'audit' ? '审计日志' : (section === 'defaults' ? '默认设置' : (section === 'addons' ? '功能开关' : '管理')) )}}</text><text>⌄</text></view><text wx:if="{{section === 'users'}}" class="top-add" bindtap="createUser">＋</text></view><view class="profile"><view class="avatar">{{userInitial}}</view><view><text class="name">{{user.username || '微信用户'}}</text><text class="muted">个人 TREK 实例</text></view></view><view wx:if="{{loading}}" class="notice">正在读取管理员数据…</view><view wx:elif="{{error}}" class="notice error">{{error}}</view><block wx:else><view class="stats"><view><text>{{stats.totalUsers}}</text><small>用户</small></view><view><text>{{stats.totalTrips}}</text><small>行程</small></view><view><text>{{stats.totalPlaces}}</text><small>地点</small></view><view><text>{{stats.totalFiles}}</text><small>文件</small></view></view><view wx:if="{{section === 'users'}}" class="user-list"><view class="section-label">用户管理</view><view wx:for="{{users}}" wx:key="id" class="user-row" data-index="{{index}}" bindtap="editUser"><view class="avatar small">{{item.initial}}</view><view class="user-copy"><text class="name">{{item.username || '未命名用户'}}</text><text class="muted">{{item.email || '微信账号'}} · {{item.role || 'user'}}</text></view><text class="online {{item.online ? 'yes' : ''}}">{{item.online ? '在线' : '离线'}}</text></view></view><view wx:elif="{{section === 'audit'}}" class="audit-list"><view class="section-label">最近操作 · {{auditTotal}} 条</view><view wx:if="{{!auditEntries.length}}" class="notice">暂无审计记录</view><view wx:for="{{auditEntries}}" wx:key="id" class="audit-row"><view class="audit-head"><text class="name">{{item.action}}</text><text class="muted">{{item.created_at}}</text></view><text class="muted">{{item.username || item.user_email || '系统用户'}}{{item.resource ? ' · ' + item.resource : ''}}</text></view></view><view wx:elif="{{section === 'defaults'}}" class="settings-list"><view class="section-label">新用户默认设置</view><view wx:for="{{['default_currency','temperature_unit','distance_unit','time_format']}}" wx:key="*this" class="setting-row" data-key="{{item}}" bindtap="editDefault"><view><text class="name">{{item}}</text><text class="muted">新账号创建后使用的默认值</text></view><text class="value">{{defaults[item] || '未设置'}} ›</text></view></view><view wx:elif="{{section === 'addons'}}" class="settings-list"><view class="section-label">实例功能开关</view><view wx:for="{{addons}}" wx:key="id" class="setting-row"><view><text class="name">{{item.name || item.id}}</text><text class="muted">{{item.description || 'TREK 可选功能'}}</text></view><switch checked="{{item.enabled}}" data-index="{{index}}" bindchange="toggleAddon" /></view><view class="section-label sub-label">地图与协作</view><view class="setting-row"><view><text class="name">行李追踪</text><text class="muted">Packing 行李状态跟踪</text></view><switch checked="{{featureFlags.bagTracking}}" data-name="bagTracking" bindchange="toggleFeature" /></view><view wx:for="{{['chat','notes','polls','whatsnext']}}" wx:key="*this" class="setting-row"><view><text class="name">协作 {{item}}</text><text class="muted">Trip 协作子功能</text></view><switch checked="{{featureFlags.collab[item]}}" data-name="{{item}}" bindchange="toggleCollab" /></view><view wx:for="{{['placesPhotos','placesAutocomplete','placesDetails','placesEnrich']}}" wx:key="*this" class="setting-row"><view><text class="name">地图服务 {{item}}</text><text class="muted">地点搜索、详情、照片和增强信息</text></view><switch checked="{{featureFlags[item]}}" data-name="{{item}}" bindchange="toggleFeature" /></view></view></block><view class="section"><view bindtap="openSettings"><text>⚙ 设置与外观</text><text>›</text></view><view bindtap="openNotifications"><text>♧ 通知中心</text><text>›</text></view></view><view class="notice"><text class="notice-title">小程序管理</text><text>插件、服务器配置、备份和权限矩阵仍可从 TREK 网页端管理员页面操作。</text></view><bottom-nav active="more" center-mode="logo" bind:create="back" /></view>
