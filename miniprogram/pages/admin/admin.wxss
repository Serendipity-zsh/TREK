.page{min-height:100vh;padding:34rpx 32rpx;background:#f5f6f8;color:#11151f;box-sizing:border-box}.top{display:flex;align-items:center;gap:20rpx}.section-switch{display:flex;align-items:center;gap:18rpx}.back{font-size:60rpx;line-height:1}.title{font-size:40rpx;font-weight:900}.profile{display:flex;align-items:center;gap:20rpx;margin-top:42rpx;padding:28rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e2e4e8}.avatar{width:84rpx;height:84rpx;line-height:84rpx;border-radius:50%;text-align:center;background:#5258e7;color:#fff;font-size:38rpx;font-weight:800}.avatar.small{width:60rpx;height:60rpx;line-height:60rpx;font-size:26rpx;flex:none}.name{display:block;font-size:32rpx;font-weight:800}.muted{display:block;margin-top:8rpx;color:#7a818c;font-size:22rpx}.section{margin-top:28rpx;padding:0 26rpx;border-radius:28rpx;background:#fff}.section view{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #eef0f2;font-size:28rpx}.section view:last-child{border-bottom:0}.notice{margin-top:30rpx;padding:28rpx;border-radius:28rpx;background:#eef5ff;color:#5d6a7e;font-size:24rpx;line-height:1.6}.notice-title{display:block;margin-bottom:10rpx;color:#11151f;font-size:30rpx;font-weight:800}.stats{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:28rpx}.stats view{padding:24rpx;border-radius:22rpx;background:#fff;border:1rpx solid #e2e4e8}.stats text,.stats small{display:block}.stats text{font-size:42rpx;font-weight:900}.stats small{margin-top:8rpx;color:#7a818c;font-size:21rpx}.user-list{margin-top:28rpx}.section-label{margin-bottom:14rpx;font-size:28rpx;font-weight:800}.user-row{display:flex;align-items:center;gap:16rpx;padding:20rpx;border-bottom:1rpx solid #e9ebef;background:#fff}.user-row:first-of-type{border-radius:22rpx 22rpx 0 0}.user-row:last-child{border-radius:0 0 22rpx 22rpx;border-bottom:0}.user-copy{min-width:0;flex:1}.user-copy .name{font-size:27rpx}.online{color:#a0a6af;font-size:21rpx}.online.yes{color:#1aad70}.error{color:#c53d55;background:#fff0f1}
