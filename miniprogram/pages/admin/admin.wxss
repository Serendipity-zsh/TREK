.page{min-height:100vh;padding:34rpx 32rpx;background:#f5f6f8;color:#11151f;box-sizing:border-box}.top{display:flex;align-items:center;gap:20rpx}.back{font-size:60rpx;line-height:1}.title{font-size:40rpx;font-weight:900}.profile{display:flex;align-items:center;gap:20rpx;margin-top:42rpx;padding:28rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e2e4e8}.avatar{width:84rpx;height:84rpx;line-height:84rpx;border-radius:50%;text-align:center;background:#5258e7;color:#fff;font-size:38rpx;font-weight:800}.name{display:block;font-size:32rpx;font-weight:800}.muted{display:block;margin-top:8rpx;color:#7a818c;font-size:22rpx}.section{margin-top:28rpx;padding:0 26rpx;border-radius:28rpx;background:#fff}.section view{display:flex;justify-content:space-between;padding:30rpx 0;border-bottom:1rpx solid #eef0f2;font-size:28rpx}.section view:last-child{border-bottom:0}.notice{margin-top:30rpx;padding:28rpx;border-radius:28rpx;background:#eef5ff;color:#5d6a7e;font-size:24rpx;line-height:1.6}.notice-title{display:block;margin-bottom:10rpx;color:#11151f;font-size:30rpx;font-weight:800}
