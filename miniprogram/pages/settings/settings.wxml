<view class="page {{dark ? 'dark' : ''}}">
  <view class="top-bar"><view class="top-icon" bindtap="goHome">‹</view><view class="section-switch" bindtap="toggleTabs"><text>⚙ {{activeLabel}}</text><text>⌄</text></view><view class="top-spacer"></view><text class="top-caption">TREK</text></view>
  <view wx:if="{{dropOpen}}" class="tab-menu"><view wx:for="{{tabs}}" wx:key="id" class="tab-item {{activeTab === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectTab">{{item.label}}</view></view>
  <view wx:if="{{activeTab === 'display'}}"><view class="profile-card"><view class="avatar">{{avatarText}}</view><view><text class="profile-name">{{user.username || '微信用户'}}</text><text class="profile-email">{{user.email || '微信登录'}}</text></view><text class="profile-arrow">›</text></view><view class="section-label">启动与地区</view><view class="setting-row" data-key="start_page" bindtap="choosePref"><view><text class="setting-title">启动页面</text><text class="setting-copy">{{prefs.start_page === 'active_trip' ? '当前行程' : '首页'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="start_trip_tab" bindtap="choosePref"><view><text class="setting-title">行程默认分区</text><text class="setting-copy">{{prefs.start_trip_tab}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="default_currency" bindtap="choosePref"><view><text class="setting-title">默认货币</text><text class="setting-copy">{{prefs.default_currency || '跟随行程'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="language" bindtap="choosePref"><view><text class="setting-title">界面语言</text><text class="setting-copy">{{prefs.language === 'en' ? 'English' : '简体中文'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="temperature_unit" bindtap="choosePref"><view><text class="setting-title">温度单位</text><text class="setting-copy">{{prefs.temperature_unit === 'fahrenheit' ? '华氏度' : '摄氏度'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="distance_unit" bindtap="choosePref"><view><text class="setting-title">距离单位</text><text class="setting-copy">{{prefs.distance_unit === 'imperial' ? '英里' : '公里'}}</text></view><text class="setting-arrow">›</text></view><view class="setting-row" data-key="time_format" bindtap="choosePref"><view><text class="setting-title">时间格式</text><text class="setting-copy">{{prefs.time_format === '12h' ? '12 小时制' : '24 小时制'}}</text></view><text class="setting-arrow">›</text></view><view class="section-label">旅行功能</view><view class="setting-row" bindtap="openCalendar"><view><text class="setting-title">Vacay 假期日历</text><text class="setting-copy">管理假期、公司假期和额度</text></view><text class="setting-arrow">›</text></view><view class="setting-row" bindtap="openTools"><view><text class="setting-title">旅程工具</text><text class="setting-copy">Journey、Collections、行李和预算</text></view><text class="setting-arrow">›</text></view><view class="section-label">地图行为</view><view class="setting-row"><view><text class="setting-title">地图显示预订标签</text><text class="setting-copy">在地图上标注交通和住宿预订</text></view><switch checked="{{prefs.map_booking_labels}}" data-key="map_booking_labels" bindchange="togglePref" color="#111013" /></view><view class="setting-row"><view><text class="setting-title">模糊预订代码</text><text class="setting-copy">隐藏截图中的敏感预订信息</text></view><switch checked="{{prefs.blur_booking_codes}}" data-key="blur_booking_codes" bindchange="togglePref" color="#111013" /></view></view>
  <view wx:elif="{{activeTab === 'appearance'}}"><view class="section-label">外观</view><view class="setting-row"><view><text class="setting-title">颜色模式</text><text class="setting-copy">在浅色和深色之间切换</text></view><switch checked="{{dark}}" bindchange="toggleTheme" color="#111013" /></view><view class="setting-row"><view><text class="setting-title">底部导航</text><text class="setting-copy">使用 TREK 五段式主导航</text></view><text class="setting-state">已启用</text></view><view class="section-label">首页 widget</view><view class="setting-row"><view><text class="setting-title">即将发生</text><text class="setting-copy">显示近期交通、酒店和活动预订</text></view><switch checked="{{widgets.upcomingReservations}}" data-key="upcomingReservations" bindchange="toggleWidget" color="#111013" /></view><view class="setting-row"><view><text class="setting-title">收藏清单</text><text class="setting-copy">显示收藏地点清单及数量</text></view><switch checked="{{widgets.collections}}" data-key="collections" bindchange="toggleWidget" color="#111013" /></view><view class="setting-row"><view><text class="setting-title">货币换算</text><text class="setting-copy">在首页显示实时汇率换算</text></view><switch checked="{{widgets.currency}}" data-key="currency" bindchange="toggleWidget" color="#111013" /></view><view class="setting-row"><view><text class="setting-title">时区</text><text class="setting-copy">显示常用城市的当前时间</text></view><switch checked="{{widgets.timezones}}" data-key="timezones" bindchange="toggleWidget" color="#111013" /></view><view class="section-label">首页顺序</view><view wx:for="{{widgetOrder}}" wx:key="*this" class="order-row"><text class="order-name">{{index + 1}} · {{item === 'currency' ? '货币换算' : item === 'collections' ? '收藏清单' : item === 'timezones' ? '时区' : '即将发生'}}</text><view class="order-actions"><text wx:if="{{index > 0}}" data-index="{{index}}" data-direction="-1" bindtap="moveWidget">↑</text><text wx:if="{{index + 1 < widgetOrder.length}}" data-index="{{index}}" data-direction="1" bindtap="moveWidget">↓</text></view></view></view>
  <view wx:elif="{{activeTab === 'map'}}"><view class="section-label">地图与位置</view><view class="setting-row" bindtap="openMap"><view><text class="setting-title">Atlas 地图</text><text class="setting-copy">高德搜索、路线和愿望单</text></view><text class="setting-arrow">›</text></view><view class="setting-row"><view><text class="setting-title">地图服务</text><text class="setting-copy">服务端使用高德 Web 服务 API</text></view><text class="setting-state">高德</text></view></view>
  <view wx:elif="{{activeTab === 'notifications'}}"><view class="section-label">通知</view><view class="setting-row" bindtap="openNotifications"><view><text class="setting-title">通知中心</text><text class="setting-copy">查看和管理 TREK 通知</text></view><text class="setting-arrow">›</text></view></view>
  <view wx:elif="{{activeTab === 'integrations'}}"><view class="section-label">服务集成</view><view class="setting-row"><view><text class="setting-title">微信云托管</text><text class="setting-copy">当前小程序使用云托管 API</text></view><text class="setting-state">已连接</text></view><view class="setting-row"><view><text class="setting-title">高德地图</text><text class="setting-copy">地点搜索与路线规划</text></view><text class="setting-state">已连接</text></view><view class="section-label">可选连接</view><view class="setting-row"><view><text class="setting-title">AirTrail 航班同步</text><text class="setting-copy">{{integrationStatus.airtrail && integrationStatus.airtrail.connected ? '连接正常' : '未连接'}}</text></view><text class="setting-state">{{integrationStatus.airtrail && integrationStatus.airtrail.connected ? '已连接' : '未配置'}}</text></view><view class="setting-row"><view><text class="setting-title">Immich 相册</text><text class="setting-copy">{{integrationStatus.immich && integrationStatus.immich.connected ? '连接正常' : '未连接'}}</text></view><text class="setting-state">{{integrationStatus.immich && integrationStatus.immich.connected ? '已连接' : '未配置'}}</text></view><view class="setting-row"><view><text class="setting-title">Synology Photos</text><text class="setting-copy">{{integrationStatus.synology && integrationStatus.synology.connected ? '连接正常' : '未连接'}}</text></view><text class="setting-state">{{integrationStatus.synology && integrationStatus.synology.connected ? '已连接' : '未配置'}}</text></view><view class="setting-row"><view><text class="setting-title">连接配置</text><text class="setting-copy">敏感密钥仍建议在 TREK 网页端配置</text></view><text class="setting-state">安全</text></view></view>
  <view wx:elif="{{activeTab === 'offline'}}"><view class="section-label">离线使用</view><view class="setting-row"><view><text class="setting-title">离线缓存</text><text class="setting-copy">微信小程序会缓存最近访问的数据</text></view><text class="setting-state">可用</text></view></view>
  <view wx:elif="{{activeTab === 'account'}}"><view class="profile-card"><view class="avatar">{{avatarText}}</view><view><text class="profile-name">{{user.username || '微信用户'}}</text><text class="profile-email">{{user.email || '微信安全登录'}}</text></view></view><view class="section-label">账号</view><view class="setting-row"><view><text class="setting-title">微信登录</text><text class="setting-copy">当前账号由微信安全身份管理</text></view><text class="setting-state">已连接</text></view><button class="logout" bindtap="logout">退出登录</button></view>
  <view wx:else><view class="section-label">关于 TREK</view><view class="about-card"><text class="about-title">TREK 旅行规划助手</text><text class="about-copy">原生微信小程序版，使用微信登录、微信云托管和高德地图服务。</text><text class="about-copy">开源项目：liketrek/TREK</text></view></view>
  <view wx:if="{{activeTab !== 'account'}}" class="account-action"><button class="logout" bindtap="logout">退出登录</button></view>
  <bottom-nav active="more" center-mode="logo" bind:create="goHome" />
</view>
