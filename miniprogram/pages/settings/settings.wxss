.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.page.dark{background:#15171d;color:#f4f5f7}.top-bar{display:flex;align-items:center;gap:20rpx;height:92rpx}.top-spacer{flex:1}.top-caption{color:#97989d;font-size:22rpx;font-weight:700;letter-spacing:2rpx}.top-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:42rpx}.section-switch{display:flex;align-items:center;gap:16rpx;min-width:250rpx;height:74rpx;padding:0 24rpx;border-radius:40rpx;background:rgba(255,255,255,.84);font-size:27rpx;font-weight:750}.section-switch text:first-child{flex:1}.tab-menu{position:relative;z-index:5;padding:12rpx;border-radius:24rpx;background:rgba(255,255,255,.96);box-shadow:0 16rpx 40rpx rgba(0,0,0,.16)}.tab-item{padding:20rpx 22rpx;border-radius:16rpx;color:#555;font-size:26rpx}.tab-item.active{background:#eef0f4;color:#111;font-weight:800}.page-title{font-size:36rpx;font-weight:750}.profile-card{display:flex;align-items:center;gap:22rpx;margin-top:32rpx;padding:30rpx;border-radius:28rpx;background:rgba(255,255,255,.8)}.profile-arrow{margin-left:auto;color:#9a9ba2;font-size:40rpx}.avatar{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;border-radius:50%;background:#50505a;color:#fff;font-size:34rpx;font-weight:700}.profile-name{display:block;font-size:32rpx;font-weight:700}.profile-email{display:block;margin-top:8rpx;color:#8d8c92;font-size:23rpx}.section-label{margin:36rpx 10rpx 14rpx;color:#777;font-size:23rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx;padding:28rpx 26rpx;border-radius:24rpx;background:rgba(255,255,255,.78)}.setting-row>view{flex:1}.setting-title{display:block;font-size:29rpx;font-weight:650}.setting-copy{display:block;margin-top:8rpx;color:#8c8a8b;font-size:22rpx}.setting-arrow{color:#777;font-size:42rpx}.setting-state{color:#1aa66e;font-size:22rpx}.about-card{padding:30rpx;border-radius:28rpx;background:rgba(255,255,255,.78)}.about-title{display:block;font-size:31rpx;font-weight:800}.about-copy{display:block;margin-top:16rpx;color:#777;font-size:23rpx;line-height:1.6}.account-action{margin-top:24rpx}.logout{margin-top:42rpx;color:#d33f58;background:rgba(214,39,59,.1);border-radius:22rpx}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:56rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
