.page{min-height:100vh;padding:32rpx 32rpx 170rpx;box-sizing:border-box;background:#f4f2ed;color:#17171b}.top-bar{display:flex;align-items:center;gap:20rpx;height:92rpx}.top-spacer{flex:1}.top-caption{color:#97989d;font-size:22rpx;font-weight:700;letter-spacing:2rpx}.top-icon{display:flex;align-items:center;justify-content:center;width:74rpx;height:74rpx;border-radius:50%;background:rgba(255,255,255,.8);font-size:42rpx}.page-title{font-size:36rpx;font-weight:750}.profile-card{display:flex;align-items:center;gap:22rpx;margin-top:32rpx;padding:30rpx;border-radius:28rpx;background:rgba(255,255,255,.8)}.profile-arrow{margin-left:auto;color:#9a9ba2;font-size:40rpx}.avatar{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;border-radius:50%;background:#50505a;color:#fff;font-size:34rpx;font-weight:700}.profile-name{display:block;font-size:32rpx;font-weight:700}.profile-email{display:block;margin-top:8rpx;color:#8d8c92;font-size:23rpx}.section-label{margin:36rpx 10rpx 14rpx;color:#777;font-size:23rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:14rpx;padding:28rpx 26rpx;border-radius:24rpx;background:rgba(255,255,255,.78)}.setting-row>view{flex:1}.setting-title{display:block;font-size:29rpx;font-weight:650}.setting-copy{display:block;margin-top:8rpx;color:#8c8a8b;font-size:22rpx}.setting-arrow{color:#777;font-size:42rpx}.setting-state{color:#1aa66e;font-size:22rpx}.logout{margin-top:42rpx;color:#d33f58;background:rgba(214,39,59,.1);border-radius:22rpx}.bottom-nav{position:fixed;right:32rpx;bottom:34rpx;left:32rpx;z-index:10;display:flex;align-items:center;justify-content:space-around;height:106rpx;border:1rpx solid rgba(255,255,255,.95);border-radius:58rpx;background:rgba(255,255,255,.9);box-shadow:0 12rpx 36rpx rgba(0,0,0,.12)}.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;width:74rpx;color:#666;font-size:30rpx}.nav-item text{margin-top:5rpx;font-size:18rpx}.nav-item.selected{color:#111}.nav-add{display:flex;align-items:center;justify-content:center;width:92rpx;height:92rpx;margin-top:-44rpx;border-radius:50%;background:#101013;color:#fff;font-size:56rpx;box-shadow:0 12rpx 24rpx rgba(0,0,0,.22)}
